# Másold át .env néven (cp .env.example .env), és töltsd ki. A .env NEM kerül verziókezelésbe.

# --- Adatbázis ---
POSTGRES_DB=localmarket
POSTGRES_USER=localmarket
POSTGRES_PASSWORD=valtoztasd-meg-erre-egy-eros-jelszora
POSTGRES_PORT=5432

# --- API ---
# JWT aláíró kulcs, legalább 32 karakter. Generálás: openssl rand -base64 48
JWT_SECRET=valtoztasd-meg-legalabb-32-karakteres-titkos-kulcsra
# Migrációk automatikus futtatása induláskor (true/false)
MIGRATE_ON_STARTUP=true
# A piac helyi időzónája (IANA azonosító); az átvételi idősávok ebben értendők
APP_TIMEZONE=Europe/Budapest

# Kezdő felhasználók jelszava (admin@localmarket.test / vevo@localmarket.test).
# Éles környezetben kötelező megváltoztatni!
ADMIN_PASSWORD=Admin123!
CUSTOMER_PASSWORD=Customer123!

# --- Kliens ---
# A böngésző által elérhető API-cím (a termékképek innen töltődnek be)
API_PUBLIC_URL=http://localhost:5205

# --- pgAdmin (opcionális) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=valtoztasd-meg
