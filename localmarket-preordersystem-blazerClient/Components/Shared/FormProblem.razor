@* Űrlap hibája: mezőnkénti validációs lista, vagy (ha nincs ilyen) a szerver üzenete. *@
@if (Problem is not null)
{
    <div class="lm-problem" role="alert">
        @if (Problem.Errors.Count > 0)
        {
            <ProblemList Problem="Problem" />
        }
        else
        {
            <span>@Problem.Message</span>
        }
    </div>
}

@code {
    [Parameter] public ApiProblem? Problem { get; set; }
}
