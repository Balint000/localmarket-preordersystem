@* Mennyiség-léptető: −/+ gombok és közvetlen beírás. A beírt értéket a lépték (Step) többszörösére kerekíti
   (pl. kg: 0,5; 1; 1,5…), a felső korlátot pedig lefelé igazítja. A végső szabályt a backend is ellenőrzi. *@
<div class="lm-stepper @(Small ? "sm" : "")" role="group" aria-label="@Label">
    <button type="button" aria-label="Kevesebb" disabled="@(Disabled || Value - Step < Min)" @onclick="() => SetAsync(Value - Step)"><Icon Name="minus" Size="16" /></button>
    <input id="@Id" type="number" inputmode="decimal" aria-label="@Label" min="@Fmt(Min)" step="@Fmt(Step)"
           value="@Fmt(Value)" disabled="@Disabled" @onchange="OnTypedAsync" />
    <button type="button" aria-label="Több" disabled="@(Disabled || (Max is { } m && Value + Step > m))" @onclick="() => SetAsync(Value + Step)"><Icon Name="plus" Size="16" /></button>
</div>

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public decimal Min { get; set; } = 1;
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public decimal Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public string Label { get; set; } = "Mennyiség";
    [Parameter] public string? Id { get; set; }

    private static string Fmt(decimal v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private async Task SetAsync(decimal v)
    {
        if (Step > 0)
            v = Math.Round(v / Step, MidpointRounding.AwayFromZero) * Step;
        v = Math.Round(v, 3);
        if (v < Min) v = Min;
        if (Max is { } m && v > m) v = Step > 0 ? Math.Max(Min, Math.Floor(m / Step) * Step) : m;
        await ValueChanged.InvokeAsync(v);
    }

    private async Task OnTypedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString()?.Replace(',', '.');
        if (decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0)
            await SetAsync(v);
        else
            await ValueChanged.InvokeAsync(Value); // érvénytelen beírás: visszaáll az előző érték
    }
}
