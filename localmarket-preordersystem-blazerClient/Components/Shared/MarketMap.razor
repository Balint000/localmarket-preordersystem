@* A piac felülnézeti térképe (csak megjelenítés): a standok a rácson, a kiosztott árusokkal.
   A szerkesztő az AdminMarketLayout oldal; ez a komponens a vevőnek és az árusnak mutatja, hol a stand. *@
@if (Layout is null || Layout.Stalls.Count == 0)
{
    <p class="small text-muted mb-0">A piac elrendezése még nincs megadva.</p>
}
else
{
    <div class="lm-map" role="img" aria-label="@AriaText"
         style="grid-template-columns: repeat(@Layout.Columns, var(--lm-map-cell)); grid-template-rows: repeat(@Layout.Rows, auto);">
        @for (var y = 0; y < Layout.Rows; y++)
        {
            for (var x = 0; x < Layout.Columns; x++)
            {
                <div class="lm-map-cell" style="grid-column:@(x + 1); grid-row:@(y + 1)" aria-hidden="true"></div>
            }
        }
        @foreach (var s in Layout.Stalls)
        {
            <div class="lm-map-stall @Css(s)" aria-hidden="true"
                 style="grid-column:@(s.X + 1) / span @s.Width; grid-row:@(s.Y + 1) / span @s.Height"
                 title="@Title(s)">
                <span class="num">@s.Number</span>
                @if (ShowNames && (s.ProducerName ?? s.Label) is { } text) { <span class="who">@text</span> }
            </div>
        }
    </div>
    @if (ShowLegend)
    {
        <div class="lm-map-legend" aria-hidden="true">
            @if (Highlight is not null) { <span class="highlight">@HighlightText</span> }
            <span class="taken">kiosztott stand</span>
            <span>szabad stand</span>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public MarketLayoutInfo? Layout { get; set; }
    /// <summary>Kiemelt standszám (pl. a termék árusáé).</summary>
    [Parameter] public int? Highlight { get; set; }
    [Parameter] public string HighlightText { get; set; } = "a keresett stand";
    [Parameter] public bool ShowNames { get; set; } = true;
    [Parameter] public bool ShowLegend { get; set; } = true;

    private string Css(StallInfo s) =>
        s.Number == Highlight ? "highlight"
        : s.ProducerStatus == "Pending" ? "pending"
        : s.ProducerId is not null ? "taken" : "";

    private static string Title(StallInfo s) =>
        $"{s.Number}. stand" + (s.ProducerName is { } n ? $" – {n}" : " – szabad") + (s.Label is { } l ? $" ({l})" : "");

    private string AriaText => Layout is null ? "" :
        $"A piac térképe: {Layout.Stalls.Count} stand, ebből {Layout.Stalls.Count(s => s.ProducerId is not null)} kiosztva."
        + (Highlight is int h ? $" Kiemelve: {h}. stand." : "");
}
