@implements IDisposable
@inject ToastService Toasts

<div class="lm-toasts" aria-live="polite" aria-atomic="false">
    @foreach (var toast in Toasts.Items)
    {
        <div @key="toast.Id" class="lm-toast lm-toast-@toast.Kind.ToString().ToLowerInvariant()" role="@(toast.Kind == ToastKind.Error ? "alert" : "status")">
            <Icon Name="@(toast.Kind switch { ToastKind.Success => "check-circle", ToastKind.Error => "alert", _ => "info" })" />
            <span class="lm-toast-msg">@toast.Message</span>
            <button type="button" class="lm-toast-close" aria-label="Értesítés bezárása" @onclick="() => Toasts.Dismiss(toast.Id)"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Toasts.Changed -= OnChanged;
}
