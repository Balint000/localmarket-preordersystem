<section class="lm-page">
    <header class="lm-page-header @HeaderClass">
        <div>
            @if (!string.IsNullOrWhiteSpace(BackHref))
            {
                <a class="lm-back" href="@BackHref"><Icon Name="arrow-left" Size="16" />@BackText</a>
            }
            <h1 tabindex="-1">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="text-muted mb-0">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="lm-page-actions">@Actions</div>
        }
    </header>
    @ChildContent
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Visszalépés a szülőoldalra (a cím fölött jelenik meg).</summary>
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackText { get; set; } = "Vissza";
    [Parameter] public string? HeaderClass { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
