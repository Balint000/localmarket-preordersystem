@page "/products/{Id:int}"
@inject CatalogApi Catalog
@inject ApiUrls Urls
@inject CartService Cart
@inject AuthStateService Auth
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject VendorApi Vendor

<PageTitle>@(_product?.Name ?? "Termék") – LocalMarket</PageTitle>

<PageContainer Title="@(_product?.Name ?? "Termék")" Subtitle="@_product?.ProducerName" BackHref="products" BackText="A heti kínálat">
    <ChildContent>

    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (_problem is not null)
    {
        <ErrorMessage Problem="_problem" OnRetry="LoadAsync" />
    }
    else if (_product is not null)
    {
        <div class="row g-4 align-items-stretch">
            <div class="col-md-6 col-lg-7">
                <div class="lm-detail-cover @Look.Css">
                    @if (Urls.Image(_product.ImageUrl) is { } img)
                    {
                        <img class="lm-product-photo" src="@img" alt="@_product.Name" />
                    }
                    else
                    {
                        <span class="lm-emoji" aria-hidden="true">@Look.Emoji</span>
                    }
                    @if (_product.NextStock is { } tagStock)
                    {
                        <PriceTag Price="tagStock.UnitPrice" Unit="@tagStock.Unit" Hang="true" Large="true" CssClass="@(Available ? null : "muted")" />
                    }
                </div>
            </div>
            <div class="col-md-6 col-lg-5">
                <div class="lm-card raised lm-buy h-100">
                    <div>
                        @foreach (var c in _product.Categories) { <span class="lm-chip">@c.Name</span> }
                        @foreach (var a in _product.Allergies) { <span class="lm-chip lm-chip-warn" title="Allergén">@Labels.Allergy(a)</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_product.Description))
                    {
                        <p class="mb-0">@_product.Description</p>
                    }

                    @if (_product.NextStock is { } stock)
                    {
                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold @(Available ? "" : "text-danger")">@(Available ? $"Még {Labels.Qty(stock.AvailableQuantity)} {Labels.Unit(stock.Unit)} rendelhető" : "Erre a hétre elfogyott")</span>
                                <span class="text-muted">@Labels.DateShort(stock.WeekStartDate) hete</span>
                            </div>
                            <div class="lm-meter @(AvailableShare <= 20 ? "low" : "")" role="img" aria-label="A heti készlet @(AvailableShare) százaléka elérhető">
                                <span style="width:@(AvailableShare)%"></span>
                            </div>
                        </div>

                        @if (!Auth.IsAuthenticated)
                        {
                            <a class="btn btn-primary btn-lg" href="login?returnUrl=products/@Id"><Icon Name="login" />Jelentkezz be a rendeléshez</a>
                        }
                        else if (Auth.Role == "Customer")
                        {
                            <form @onsubmit="AddToCartAsync" @onsubmit:preventDefault="true">
                                <label class="form-label" for="qty">Mennyiség (@Labels.Unit(stock.Unit))</label>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <QuantityStepper Id="qty" @bind-Value="_quantity" Min="@MinQty(stock)" Step="@Step(stock)"
                                                     Max="@(stock.AvailableQuantity > 0 ? stock.AvailableQuantity : null)" Disabled="!Available" Label="@($"Mennyiség ({Labels.Unit(stock.Unit)})")" />
                                    <span class="text-muted small">összesen <strong class="text-body">@Labels.Money(_quantity * stock.UnitPrice)</strong></span>
                                </div>
                                <SubmitButton Busy="_adding" Disabled="!Available" CssClass="btn-primary btn-lg w-100 mt-3"><Icon Name="cart" />Kosárba teszem</SubmitButton>
                                @if (_addProblem is not null)
                                {
                                    <div class="mt-3"><ErrorMessage Problem="_addProblem" /></div>
                                }
                            </form>
                        }
                        else
                        {
                            <div class="lm-callout info mb-0"><Icon Name="info" /><div class="lm-callout-body">Rendelni vásárlói fiókkal lehet.</div></div>
                        }
                    }
                    else
                    {
                        <div class="lm-callout info mb-0"><Icon Name="info" /><div class="lm-callout-body">Ehhez a termékhez még nincs meghirdetett heti kínálat, ezért most nem rendelhető.</div></div>
                    }
                </div>
            </div>
        </div>

        @if (Auth.Role == "Admin" && !_product.IsArchived)
        {
            <div class="lm-callout warn mt-3"><Icon Name="warning" />
                <div class="lm-callout-body">
                    <strong>Piacvezetői művelet</strong>
                    A termék törlésekor a rá vonatkozó aktív (függő vagy elfogadott) rendelések lemondásra kerülnek, a vásárlók látják az indoklást.
                    <div class="mt-2"><button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => { _deleteReason = string.Empty; _confirmDelete = true; }"><Icon Name="trash" Size="16" />Termék törlése</button></div>
                </div>
            </div>
        }
        @if (_product.IsArchived)
        {
            <div class="lm-callout bad mt-3"><Icon Name="x-circle" /><div class="lm-callout-body">Ez a termék törölve lett a kínálatból, már nem rendelhető.</div></div>
        }

        <ConfirmDialog Visible="_confirmDelete" Title="@($"Termék törlése: {_product.Name}")" Danger="true" Busy="_deleting"
                       ConfirmText="Törlöm" CancelText="Mégse" ConfirmDisabled="string.IsNullOrWhiteSpace(_deleteReason)"
                       Message="Ha a termékre volt rendelés, archiválódik (az előzmény megmarad), különben véglegesen törlődik."
                       OnConfirm="DeleteAsync" OnCancel="() => _confirmDelete = false">
            <label class="form-label" for="del-reason">Indoklás (kötelező; a lemondott rendeléseknél a vásárló látja)</label>
            <textarea id="del-reason" class="form-control" rows="3" maxlength="500" @bind="_deleteReason" @bind:event="oninput"></textarea>
        </ConfirmDialog>

        <div class="row g-4 mt-1">
            <div class="col-lg-5">
                <div class="lm-card h-100">
                    <div class="lm-card-title"><h2><Icon Name="store" />Az árusról</h2></div>
                    <dl class="lm-facts">
                        <dt>Árus</dt><dd class="fw-bold">@_product.ProducerName<div><a class="small fw-normal" href="products?producerId=@_product.ProducerId">Az árus további termékei</a></div></dd>
                        @if (_producer is not null) { <dt>Stand</dt><dd>@(_producer.StallNumber > 0 ? $"{_producer.StallNumber}. számú stand" : "még nincs kiosztva")</dd> }
                        @if (_market is not null)
                        {
                            <dt>Piac</dt><dd>@_market.Name<div class="small text-muted">@_market.Address</div></dd>
                            <dt>Nyitva</dt><dd>@(_market.OpeningDays.Count == 0 ? "–" : string.Join(", ", _market.OpeningDays.Select(Labels.Day)))<div class="small text-muted">@_market.HoursText</div></dd>
                        }
                    </dl>
                    @if (_layout is { Stalls.Count: > 0 } && _producer is { StallNumber: > 0 })
                    {
                        <div class="mt-3">
                            <div class="small fw-bold mb-1">Hol találod a piacon?</div>
                            <MarketMap Layout="_layout" Highlight="_producer.StallNumber" OnlyHighlightedInLegend="true" Compact="true" />
                        </div>
                    }
                    @if (_weather is { ForecastAvailable: true } w)
                    {
                        <div class="lm-weather">
                            <span class="lm-weather-icon" aria-hidden="true"><Icon Name="@Labels.WeatherIcon(w)" /></span>
                            <div>
                                <div class="small text-muted">Időjárás a következő piacnapon, @Labels.DateLong(w.Date)</div>
                                <div class="lm-weather-temp">@Labels.Qty((decimal)(w.TemperatureMinC ?? 0))–@Labels.Qty((decimal)(w.TemperatureMaxC ?? 0)) °C</div>
                                <div class="small">@w.Description, csapadék: @Labels.Qty((decimal)(w.PrecipitationMm ?? 0)) mm</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-7">
                <div class="lm-card mb-4">
                    <div class="lm-card-title"><h2><Icon Name="clock" />Szabad átvételi időpontok</h2></div>
                    @if (_slots.Count == 0) { <p class="text-muted mb-0">Az árus még nem hirdetett meg szabad átvételi időpontot.</p> }
                    else
                    {
                        <div>
                            @foreach (var sl in _slots)
                            {
                                <span class="lm-slot-chip">
                                    <strong>@Labels.DateShort(sl.Date), @Labels.Day(sl.Date.DayOfWeek.ToString())</strong>
                                    <span>@Labels.Time(sl.StartTime)–@Labels.Time(sl.EndTime), @sl.FreeCapacity szabad hely</span>
                                </span>
                            }
                        </div>
                    }
                </div>
                <div class="lm-card">
                    <div class="lm-card-title"><h2><Icon Name="calendar" />Heti kínálat</h2></div>
                    @if (_product.WeeklyStocks.Count == 0) { <p class="text-muted mb-0">Még nincs meghirdetett készlet.</p> }
                    else
                    {
                        <table class="table lm-table mb-0">
                            <thead><tr><th>Hét</th><th class="text-end">Elérhető</th><th class="text-end">Ár</th></tr></thead>
                            <tbody>
                            @foreach (var ws in _product.WeeklyStocks)
                            {
                                <tr><td>@Labels.DateShort(ws.WeekStartDate) hete</td><td class="text-end">@Labels.Qty(ws.AvailableQuantity) / @Labels.Qty(ws.Quantity) @Labels.Unit(ws.Unit)</td><td class="text-end">@Labels.Money(ws.UnitPrice) / @Labels.Unit(ws.Unit)</td></tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
</ChildContent>
</PageContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ProductInfo? _product;
    private ApiProblem? _problem, _addProblem;
    private bool _loading = true, _adding;
    private decimal _quantity = 1;
    private bool _confirmDelete, _deleting;
    private string _deleteReason = string.Empty;

    private ProducerInfo? _producer;
    private MarketInfo? _market;
    private MarketLayoutInfo? _layout;
    private MarketWeatherInfo? _weather;
    private IReadOnlyList<PickupSlotInfo> _slots = [];

    private (string Emoji, string Css) Look => Labels.CategoryLook(_product?.Categories.FirstOrDefault()?.Name);

    private bool Available => _product?.NextStock is { AvailableQuantity: > 0 };

    private int AvailableShare => _product?.NextStock is { Quantity: > 0 } s
        ? (int)Math.Clamp(Math.Round(s.AvailableQuantity / s.Quantity * 100), 0, 100)
        : 0;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        var result = await Catalog.ProductAsync(Id);
        if (result.IsSuccess) _product = result.Value; else { _product = null; _problem = result.Problem; }
        _loading = false;
        if (_product?.NextStock is { } st) _quantity = Math.Max(Step(st), 1m); // kg/l: 1, g: 100, darab: 1
        if (_product is not null) await LoadExtrasAsync(_product);
    }

    // kiegészítő információk: hiba esetén egyszerűen kimaradnak, a termék megrendelhetőségét nem érintik
    private async Task LoadExtrasAsync(ProductInfo product)
    {
        _producer = null; _market = null; _weather = null; _slots = []; _layout = null;
        var producers = await Catalog.ProducersAsync();
        _producer = producers.Value?.FirstOrDefault(p => p.Id == product.ProducerId);
        var slots = await Catalog.PickupSlotsAsync(product.ProducerId);
        _slots = slots.Value?.Where(s => s.Date.Date >= DateTime.Today && s.FreeCapacity > 0 && s.IsBookable).OrderBy(s => s.Date).ThenBy(s => s.StartTime).Take(8).ToList() ?? [];
        if (_producer is not null)
        {
            var markets = await Catalog.MarketsAsync();
            _market = markets.Value?.FirstOrDefault(m => m.Id == _producer.MarketId);
            var layout = await Catalog.MarketLayoutAsync(_producer.MarketId);
            if (layout.IsSuccess) _layout = layout.Value;
            if (_market is { Latitude: not null } && NextOpening(_market) is { } day)
            {
                var w = await Catalog.WeatherAsync(_market.Id, day);
                if (w.IsSuccess) _weather = w.Value;
            }
        }
    }

    private static DateTime? NextOpening(MarketInfo market)
    {
        for (var i = 0; i < 7; i++)
        {
            var d = DateTime.Today.AddDays(i);
            if (market.OpeningDays.Contains(d.DayOfWeek.ToString())) return d;
        }
        return null;
    }

    // A rendelési léptéket a backend adja (Domain: UnitsExtensions.OrderStep): kg/l 0,5-ösével, dkg 10-esével,
    // g/ml 100-asával, darabos egészenként. A legkisebb rendelhető mennyiség maga a lépték.
    private static decimal Step(ProductStockInfo s) => s.OrderStep > 0 ? s.OrderStep : 1m;
    private static decimal MinQty(ProductStockInfo s) => Step(s);

    private async Task DeleteAsync()
    {
        if (_deleting || _product is null || string.IsNullOrWhiteSpace(_deleteReason)) return;
        _deleting = true;
        var r = await Vendor.DeleteProductAsync(_product.Id, _deleteReason.Trim());
        _deleting = false;
        _confirmDelete = false;
        if (r.IsSuccess && r.Value is { } res)
        {
            var what = res.Archived ? "archiválva" : "törölve";
            var cancelled = res.CancelledOrderIds.Count > 0 ? $", {res.CancelledOrderIds.Count} rendelés lemondva" : "";
            var untouched = res.UntouchedOrderIds.Count > 0 ? $"; {res.UntouchedOrderIds.Count} lejárt idősávú rendelés nem változott" : "";
            Toasts.Success($"A termék {what}{cancelled}{untouched}.");
            Navigation.NavigateTo("products");
        }
        else Toasts.Error(r.Problem?.Message ?? "A törlés nem sikerült.");
    }

    private async Task AddToCartAsync()
    {
        if (_adding || _product is null) return;
        _adding = true;
        _addProblem = null;

        var result = await Cart.AddAsync(_product.Id, _quantity);
        if (result.IsSuccess)
            Toasts.Success($"„{_product.Name}” a kosárba került.");
        else
            _addProblem = result.Problem;

        _adding = false;
    }
}
