@page "/products/{Id:int}"
@inject CatalogApi Catalog
@inject CartService Cart
@inject AuthStateService Auth
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>@(_product?.Name ?? "Termék") – LocalMarket</PageTitle>

<PageContainer Title="@(_product?.Name ?? "Termék")" Subtitle="@_product?.ProducerName">
    <Actions><a class="btn btn-outline-secondary" href="products">← Vissza a termékekhez</a></Actions>
    <ChildContent>

    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (_problem is not null)
    {
        <ErrorMessage Problem="_problem" OnRetry="LoadAsync" />
    }
    else if (_product is not null)
    {
        <div class="row g-4">
            <div class="col-md-5">
                <div class="lm-product-img rounded" style="height:260px" aria-hidden="true">🥕</div>
            </div>
            <div class="col-md-7">
                <div class="lm-card">
                    <div class="mb-2">
                        @foreach (var c in _product.Categories) { <span class="lm-chip">@c.Name</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_product.Description))
                    {
                        <p>@_product.Description</p>
                    }

                    @if (_product.Allergies.Count > 0)
                    {
                        <div class="mb-3">
                            <span class="fw-semibold">Allergének:</span>
                            @foreach (var a in _product.Allergies) { <span class="lm-chip lm-chip-warn">@Labels.Allergy(a)</span> }
                        </div>
                    }

                    @if (_product.NextStock is { } stock)
                    {
                        <div class="lm-price fs-4">@Labels.Money(stock.UnitPrice) <span class="text-muted fw-normal fs-6">/ @Labels.Unit(stock.Unit)</span></div>
                        <div class="mb-3 @(Available ? "text-success" : "text-danger")">
                            @(Available ? $"Elérhető: {Labels.Qty(stock.AvailableQuantity)} {Labels.Unit(stock.Unit)} (hét: {Labels.Date(stock.WeekStartDate)})" : "Erre a hétre elfogyott.")
                        </div>

                        @if (!Auth.IsAuthenticated)
                        {
                            <a class="btn btn-primary" href="login?returnUrl=products/@Id">Jelentkezz be a rendeléshez</a>
                        }
                        else if (Auth.Role == "Customer")
                        {
                            <EditForm Model="this" OnSubmit="AddToCartAsync" FormName="add-to-cart">
                                <div class="d-flex flex-wrap align-items-end gap-2">
                                    <div>
                                        <label class="form-label mb-1" for="qty">Mennyiség (@Labels.Unit(stock.Unit))</label>
                                        <input id="qty" type="number" class="form-control" style="width:140px"
                                               min="@MinQty(stock)" step="@Step(stock)" @bind="_quantity" @bind:event="oninput" disabled="@(!Available)" />
                                    </div>
                                    <SubmitButton Busy="_adding" Disabled="!Available">Kosárba</SubmitButton>
                                </div>
                                @if (_addProblem is not null)
                                {
                                    <div class="mt-3"><ErrorMessage Problem="_addProblem" /></div>
                                }
                            </EditForm>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Rendelni csak vásárlói fiókkal lehet.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Ehhez a termékhez még nincs meghirdetett kínálat, ezért nem rendelhető.</p>
                    }
                </div>
            </div>
        </div>
    }
</ChildContent>
</PageContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ProductInfo? _product;
    private ApiProblem? _problem, _addProblem;
    private bool _loading = true, _adding;
    private decimal _quantity = 1;

    private bool Available => _product?.NextStock is { AvailableQuantity: > 0 };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        var result = await Catalog.ProductAsync(Id);
        if (result.IsSuccess) _product = result.Value; else { _product = null; _problem = result.Problem; }
        _loading = false;
    }

    // csak beviteli segítség: darab-egységnél egész lépés; a szabályt a backend kényszeríti
    private static string Step(ProductStockInfo s) => s.Unit == "Piece" ? "1" : "0.1";
    private static string MinQty(ProductStockInfo s) => s.Unit == "Piece" ? "1" : "0.1";

    private async Task AddToCartAsync()
    {
        if (_adding || _product is null) return;
        _adding = true;
        _addProblem = null;

        var result = await Cart.AddAsync(_product.Id, _quantity);
        if (result.IsSuccess)
            Toasts.Success($"„{_product.Name}” a kosárba került.");
        else
            _addProblem = result.Problem;

        _adding = false;
    }
}
