@page "/vendor/picking-list"
@attribute [Authorize(Roles = "Producer")]
@inject OrdersApi Api
@inject FileDownloader Downloader
@inject ToastService Toasts

<PageTitle>Átvételi lista – LocalMarket</PageTitle>

<PageContainer Title="Átvételi lista" Subtitle="Egy piacnap átvételeinek összesítője egy fájlban, a standhoz.">
    <div class="lm-card" style="max-width:34rem">
        <div class="lm-card-title"><h2><Icon Name="clipboard" />Melyik napra?</h2></div>
        <label class="form-label" for="pl-date">Dátum</label>
        <input id="pl-date" type="date" class="form-control mb-1" @bind="_date" />
        <div class="form-text mb-3">@Labels.DateLong(_date)</div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick='() => ExportAsync("Csv")'><Icon Name="download" />CSV letöltése</button>
            <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick='() => ExportAsync("Json")'><Icon Name="download" />JSON letöltése</button>
        </div>
        <p class="small text-muted mt-3 mb-0">A CSV táblázatkezelőben (pl. Excel) nyitható meg és nyomtatható.</p>
    </div>
</PageContainer>

@code {
    private DateTime _date = DateTime.Today;
    private bool _busy;

    private async Task ExportAsync(string format)
    {
        if (_busy) return;
        _busy = true;
        var result = await Api.ExportPickingListAsync(_date, format);
        if (result.IsSuccess) await Downloader.SaveAsync(result.Value!);
        else Toasts.Error(result.Problem!.Message);
        _busy = false;
    }
}
