@page "/vendor/slots"
@attribute [Authorize(Roles = "Producer")]
@inject CatalogApi Catalog
@inject VendorApi Vendor
@inject AuthStateService Auth
@inject ToastService Toasts

<PageTitle>Átvételi időpontok – LocalMarket</PageTitle>

<PageContainer Title="Átvételi időpontok" Subtitle="Ezek közül választanak a vásárlók rendeléskor">
    <ChildContent>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="lm-card">
                    <div class="lm-card-title"><h2><Icon Name="@(_editId is null ? "plus" : "pencil")" />@(_editId is null ? "Új időpont" : "Időpont szerkesztése")</h2></div>
                    <div class="mb-2"><label class="form-label" for="sl-date">Nap</label><input id="sl-date" type="date" class="form-control" @bind="_date" /></div>
                    <div class="row g-2 mb-2">
                        <div class="col"><label class="form-label" for="sl-from">Kezdés</label><input id="sl-from" type="time" class="form-control" @bind="_from" /></div>
                        <div class="col"><label class="form-label" for="sl-to">Vége</label><input id="sl-to" type="time" class="form-control" @bind="_to" /></div>
                    </div>
                    <div class="mb-3"><label class="form-label" for="sl-cap">Kapacitás (rendelések száma)</label><input id="sl-cap" type="number" min="1" class="form-control" @bind="_capacity" /></div>
                    <FormProblem Problem="_createProblem" />
                    <SubmitButton Busy="_busy" CssClass="btn-primary" OnClick="SaveAsync">@(_editId is null ? "Időpont meghirdetése" : "Mentés")</SubmitButton>
                    @if (_editId is not null) { <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Mégse</button> }
                </div>
            </div>
            <div class="col-lg-8">
                @if (_loading) { <LoadingIndicator /> }
                else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
                else if (_slots.Count == 0) { <EmptyState Title="Még nincs átvételi időpont" IconName="clock" Text="Hirdess meg legalább egyet: időpont nélkül a vásárlók nem tudnak tőled rendelni." /> }
                else
                {
                    <div class="lm-table-wrap">
                        <table class="table lm-table">
                            <thead><tr><th>Nap</th><th>Időszak</th><th>Foglaltság</th><th class="text-end"><span class="visually-hidden">Műveletek</span></th></tr></thead>
                            <tbody>
                            @foreach (var s in _slots.OrderBy(s => s.Date).ThenBy(s => s.StartTime))
                            {
                                <tr class="@(_editId == s.Id ? "table-active" : "")"><td><strong>@Labels.DateShort(s.Date)</strong><div class="small text-muted">@Labels.DayRelative(s.Date)</div></td><td>@Labels.Time(s.StartTime)–@Labels.Time(s.EndTime)</td>
                                    <td class="lm-bar-cell">
                                        <div class="small mb-1">@s.BookedCount / @s.Capacity foglalt, @s.FreeCapacity szabad</div>
                                        <div class="lm-meter @(s.FreeCapacity == 0 ? "bad" : "")" aria-hidden="true"><span style="width:@(s.Capacity > 0 ? s.BookedCount * 100 / s.Capacity : 0)%"></span></div>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(s)"><Icon Name="pencil" Size="16" />Szerkesztés</button>
                                        <button type="button" class="lm-icon-btn" aria-label="@Labels.DateShort(s.Date) @Labels.Time(s.StartTime) időpont törlése" title="Törlés" @onclick="() => _deleting = s"><Icon Name="trash" Size="18" /></button>
                                    </td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <ConfirmDialog Visible="_deleting is not null" Title="Törlöd az átvételi időpontot?" Danger="true" Busy="_busy"
                       Message="Csak olyan időpont törölhető, amelyre még nincs foglalás."
                       ConfirmText="Igen, törlöm" CancelText="Mégsem"
                       OnConfirm="DeleteAsync" OnCancel="() => _deleting = null" />
    </ChildContent>
</PageContainer>

@code {
    private IReadOnlyList<PickupSlotInfo> _slots = [];
    private ApiProblem? _problem, _createProblem;
    private bool _loading = true, _busy;
    private DateTime _date = DateTime.Today.AddDays(1);
    private TimeOnly _from = new(8, 0), _to = new(12, 0);
    private int _capacity = 10;
    private int? _editId;
    private PickupSlotInfo? _deleting;

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        if (Auth.ProducerId is not int pid)
        {
            _problem = new ApiProblem(ApiFailure.Forbidden, "Nincs árus-profil", "A fiókhoz nem tartozik árus-profil.", new Dictionary<string, string[]>());
        }
        else
        {
            var r = await Catalog.PickupSlotsAsync(pid);
            if (r.IsSuccess) _slots = r.Value!; else _problem = r.Problem;
        }
        _loading = false;
    }

    private void StartEdit(PickupSlotInfo s)
    {
        _editId = s.Id; _date = s.Date; _from = s.StartTime; _to = s.EndTime; _capacity = s.Capacity;
        _createProblem = null;
    }

    private void CancelEdit()
    {
        _editId = null; _createProblem = null;
        _date = DateTime.Today.AddDays(1); _from = new(8, 0); _to = new(12, 0); _capacity = 10;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true; _createProblem = null;
        var request = new CreatePickupSlotRequest(_date, _from, _to, _capacity);
        var r = _editId is int id
            ? await Vendor.UpdatePickupSlotAsync(id, request)
            : await Vendor.CreatePickupSlotAsync(request);
        if (r.IsSuccess)
        {
            Toasts.Success(_editId is null ? "Időpont meghirdetve." : "Időpont módosítva.");
            if (_editId is not null) CancelEdit();
            await LoadAsync();
        }
        else _createProblem = r.Problem;
        _busy = false;
    }

    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true;
        var r = await Vendor.DeletePickupSlotAsync(_deleting.Id);
        if (r.IsSuccess) { Toasts.Success("Időpont törölve."); if (_editId == _deleting.Id) CancelEdit(); await LoadAsync(); }
        else Toasts.Error(r.Problem!.Message);
        _deleting = null;
        _busy = false;
    }
}
