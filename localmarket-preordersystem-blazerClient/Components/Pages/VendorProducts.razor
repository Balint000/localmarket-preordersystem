@page "/vendor/products"
@attribute [Authorize(Roles = "Producer")]
@inject CatalogApi Catalog
@inject AuthStateService Auth
@inject VendorApi Vendor
@inject ToastService Toasts

<PageTitle>Termékeim – LocalMarket</PageTitle>

<PageContainer Title="Termékeim" Subtitle="Hirdesd meg termékeidet, és add meg a heti készletet">
    <Actions><a class="btn btn-primary" href="vendor/products/new"><Icon Name="plus" />Új termék</a></Actions>
    <ChildContent>
        @if (_review.Count > 0)
        {
            <div class="lm-card mb-4" aria-labelledby="rv-title">
                <div class="lm-card-title"><h2 id="rv-title"><Icon Name="chart" />Visszajelzés a lezárt hetekről</h2><span class="small text-muted">meghirdetett / rendelt / maradt</span></div>
                @if (_review.Any(r => r.Verdict != "Balanced"))
                {
                    <p class="small mb-2">@_review.Count(r => r.Verdict is "HighLeftover" or "NoOrders") terméknél sok maradt, @_review.Count(r => r.Verdict == "SoldOut") termék elfogyott. Érdemes ehhez igazítani a következő heti mennyiséget.</p>
                }
                <div class="table-responsive border-0">
                    <table class="table lm-table mb-0">
                        <thead><tr><th>Hét</th><th>Termék</th><th class="text-end">Meghirdetve</th><th class="text-end">Rendelve</th><th class="text-end">Maradt</th><th>Javaslat</th></tr></thead>
                        <tbody>
                        @foreach (var r in _review.Take(12))
                        {
                            <tr>
                                <td class="text-nowrap">@Labels.DateShort(r.WeekStartDate) hete</td>
                                <td>@r.ProductName</td>
                                <td class="text-end">@Labels.Qty(r.Offered) @Labels.Unit(r.Unit)</td>
                                <td class="text-end">@Labels.Qty(r.Ordered)</td>
                                <td class="text-end">@Labels.Qty(r.Leftover)</td>
                                <td><span class="lm-badge @(r.Verdict switch { "SoldOut" => "badge-ok", "HighLeftover" or "NoOrders" => "badge-warn", _ => "badge-muted" })">@(r.Verdict switch { "SoldOut" => "Elfogyott", "HighLeftover" => "Sok maradt", "NoOrders" => "Nem rendeltek", _ => "Rendben" })</span>
                                    <div class="small text-muted">@r.Hint</div></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_loading) { <LoadingIndicator /> }
        else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
        else if (_products.Count == 0)
        {
            <EmptyState Title="Még nincs meghirdetett terméked" IconName="sprout" Text="Vegyél fel egy terméket, majd add meg a heti készletét és árát, hogy a vásárlók rendelhessenek.">
                <a class="btn btn-primary" href="vendor/products/new"><Icon Name="plus" />Első termék felvétele</a>
            </EmptyState>
        }
        else
        {
            <div class="lm-table-wrap">
                <table class="table lm-table align-middle">
                    <thead><tr><th>Termék</th><th>Kategória</th><th>Heti készlet</th><th class="text-end">Ár</th><th class="text-end"><span class="visually-hidden">Műveletek</span></th></tr></thead>
                    <tbody>
                    @foreach (var p in _products)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="lm-stat-icon @Labels.CategoryLook(p.Categories.FirstOrDefault()?.Name).Css" style="font-size:1.3rem" aria-hidden="true">@Labels.CategoryLook(p.Categories.FirstOrDefault()?.Name).Emoji</span>
                                    <a class="fw-bold text-body text-decoration-none" href="vendor/products/@p.Id">@p.Name</a>
                                </div>
                            </td>
                            <td>@foreach (var c in p.Categories) { <span class="lm-chip">@c.Name</span> }</td>
                            <td>
                                @if (p.NextStock is { } s)
                                {
                                    var share = s.Quantity > 0 ? (int)Math.Clamp(Math.Round(s.AvailableQuantity / s.Quantity * 100), 0, 100) : 0;
                                    <div class="lm-bar-cell">
                                        <div class="d-flex justify-content-between gap-2 small mb-1">
                                            <span class="lm-badge @(s.AvailableQuantity > 0 ? "badge-ok" : "badge-bad")">@(s.AvailableQuantity > 0 ? "Elérhető" : "Elfogyott")</span>
                                            <span class="text-muted">@Labels.Qty(s.AvailableQuantity) / @Labels.Qty(s.Quantity) @Labels.Unit(s.Unit)</span>
                                        </div>
                                        <div class="lm-meter @(share == 0 ? "bad" : share <= 20 ? "low" : "")" aria-hidden="true"><span style="width:@(share)%"></span></div>
                                    </div>
                                }
                                else { <span class="lm-badge badge-muted">Nincs meghirdetve</span> }
                            </td>
                            <td class="text-end">@(p.NextStock is { } n ? Labels.Money(n.UnitPrice) + " / " + Labels.Unit(n.Unit) : "–")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-primary btn-sm" href="vendor/products/@p.Id"><Icon Name="pencil" Size="16" />Szerkesztés</a>
                                <button type="button" class="lm-icon-btn" aria-label="@p.Name törlése" title="Törlés" @onclick="() => _deleting = p"><Icon Name="trash" Size="18" /></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <ConfirmDialog Visible="_deleting is not null" Title="@($"Törlöd a(z) {_deleting?.Name} terméket?")" Danger="true" Busy="_busy"
                       Message="A termék eltűnik a kínálatból. Ha volt rá rendelés, archiválódik (az előzmény megmarad). Függő vagy elfogadott rendelés esetén előbb azokat kell lezárni."
                       ConfirmText="Igen, törlöm" CancelText="Mégsem"
                       OnConfirm="DeleteAsync" OnCancel="() => _deleting = null" />
    </ChildContent>
</PageContainer>

@code {
    private IReadOnlyList<ProductInfo> _products = [];
    private ApiProblem? _problem;
    private bool _loading = true, _busy;
    private ProductInfo? _deleting;
    private IReadOnlyList<StockReviewLine> _review = [];

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        if (Auth.ProducerId is not int pid)
        {
            _problem = new ApiProblem(ApiFailure.Forbidden, "Nincs árus-profil", "A fiókhoz nem tartozik árus-profil.", new Dictionary<string, string[]>());
        }
        else
        {
            var r = await Catalog.ProductsOfProducerAsync(pid);
            if (r.IsSuccess) _products = r.Value!; else _problem = r.Problem;
            // a visszajelzés kiegészítő: hiba esetén egyszerűen nem jelenik meg
            var review = await Vendor.StockReviewAsync();
            _review = review.IsSuccess ? review.Value! : [];
        }
        _loading = false;
    }

    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true;
        var r = await Vendor.DeleteProductAsync(_deleting.Id);
        if (r.IsSuccess) { Toasts.Success(r.Value is { Archived: true } ? "Termék archiválva (a rendelési előzmény megmaradt)." : "Termék törölve."); _deleting = null; await LoadAsync(); }
        else { Toasts.Error(r.Problem!.Message); _deleting = null; }
        _busy = false;
    }
}
