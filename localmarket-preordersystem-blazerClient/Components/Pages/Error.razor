@page "/Error"
@using System.Diagnostics

<PageTitle>Hiba – LocalMarket</PageTitle>

<PageContainer Title="Valami elromlott">
    <EmptyState Title="A kérést nem sikerült feldolgozni" IconName="warning"
                Text="Töltsd újra az oldalt. Ha a hiba megmarad, jelezd az üzemeltetőnek, és add meg az alábbi azonosítót.">
        @if (ShowRequestId)
        {
            <p class="small mb-3">Kérés azonosítója: <code>@RequestId</code></p>
        }
        <a class="btn btn-primary" href="">Vissza a kezdőlapra</a>
    </EmptyState>
</PageContainer>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
