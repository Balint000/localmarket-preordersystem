@page "/"
@inject AuthStateService Auth
@inject NavigationManager Navigation
@inject CatalogApi Catalog

<PageTitle>LocalMarket – helyi termelői piac</PageTitle>

<section class="lm-hero">
    <h1 tabindex="-1">Friss helyi termékek, előrendelve</h1>
    <p class="lead">Rendelj a környékbeli termelőktől, válaszd ki az átvételi időpontot, és vedd át a piacon.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary btn-lg" href="products">Termékek böngészése</a>
        <a class="btn btn-outline-primary btn-lg" href="register">Regisztráció</a>
    </div>
</section>

<section class="lm-steps" aria-label="Hogyan működik">
    <div><span class="lm-step-no">1</span><h2 class="h6">Válogass</h2><p>Böngészd a termelők heti kínálatát, szűrj kategória és allergén szerint.</p></div>
    <div><span class="lm-step-no">2</span><h2 class="h6">Rendelj elő</h2><p>Tedd kosárba, és válassz átvételi időpontot minden termelőnél.</p></div>
    <div><span class="lm-step-no">3</span><h2 class="h6">Vedd át</h2><p>A termelő visszaigazolja, jelzi ha kész, te pedig átveszed a piacon.</p></div>
</section>

@if (_featured.Count > 0)
{
    <div class="lm-section-title"><h2>Kiemelt termékek</h2><a href="products">Összes termék →</a></div>
    <div class="lm-grid">
        @foreach (var p in _featured)
        {
            <ProductCard Product="p" />
        }
    </div>
}

@if (_markets.Count > 0)
{
    <div class="lm-section-title"><h2>Piacaink</h2></div>
    <div class="lm-grid">
        @foreach (var m in _markets)
        {
            <article class="lm-card">
                <h3 class="h6 mb-1">@m.Name</h3>
                <div class="text-muted small">@m.Address</div>
                <div class="small mt-2">Nyitva: @string.Join(", ", m.OpeningDays.Select(Labels.Day))</div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<ProductInfo> _featured = [];
    private IReadOnlyList<MarketInfo> _markets = [];

    protected override async Task OnInitializedAsync()
    {
        // bejelentkezett felhasználót az irányítópultra irányítjuk
        await Auth.GetAuthenticationStateAsync();
        if (Auth.IsAuthenticated) { Navigation.NavigateTo("dashboard", replace: true); return; }

        // a kiemelt tartalom hiba esetén egyszerűen elmarad
        var products = await Catalog.SearchProductsAsync(null, null, []);
        _featured = products.Value?.Where(p => p.NextStock is { AvailableQuantity: > 0 }).Take(4).ToList() ?? [];
        var markets = await Catalog.MarketsAsync();
        _markets = markets.Value?.Where(m => m.IsActive).ToList() ?? [];
    }
}
