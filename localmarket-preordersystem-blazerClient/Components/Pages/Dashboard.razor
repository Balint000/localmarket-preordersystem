@page "/dashboard"
@attribute [Authorize]
@inject AuthStateService Auth
@inject OrdersApi Orders
@inject CatalogApi Catalog
@inject VendorApi Vendor
@inject AdminApi Admin

<PageTitle>Irányítópult – LocalMarket</PageTitle>

<PageContainer Title="@Greeting" Subtitle="@($"Ma {Labels.DateLong(DateTime.Today)} van.")" HeaderClass="lm-greeting">
    <ChildContent>
        @if (_loading) { <LoadingIndicator /> }
        else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
        else
        {
            @* Figyelmeztetések: ami azonnali teendőt jelent, az legfelül, egy kattintásnyira *@
            @if (Auth.Role == "Customer" && Count("Ready") > 0)
            {
                <div class="lm-callout ok" role="status"><Icon Name="package" />
                    <div class="lm-callout-body"><strong>@Count("Ready") rendelésed átvehető</strong>A termelő összekészítette, a választott időpontban várnak a standnál.</div>
                    <a class="btn btn-primary btn-sm" href="orders">Rendeléseim</a>
                </div>
            }
            @if (Auth.Role == "Producer")
            {
                @if (_producer is { Status: not "Approved" })
                {
                    <div class="lm-callout warn" role="status"><Icon Name="clock" />
                        <div class="lm-callout-body"><strong>A gazdaságod státusza: @Labels.ProducerStatus(_producer.Status)</strong>Terméket a piacvezető jóváhagyása után hirdethetsz.</div>
                    </div>
                }
                @if (Count("Pending") > 0)
                {
                    <div class="lm-callout warn" role="status"><Icon Name="inbox" />
                        <div class="lm-callout-body"><strong>@Count("Pending") új rendelés vár válaszra</strong>Fogadd el vagy utasítsd el őket, hogy a vásárlók tervezhessenek.</div>
                        <a class="btn btn-primary btn-sm" href="vendor/orders">Megnézem</a>
                    </div>
                }
            }
            @if (Auth.Role == "Admin" && _pendingProducers > 0)
            {
                <div class="lm-callout warn" role="status"><Icon Name="users" />
                    <div class="lm-callout-body"><strong>@_pendingProducers árus vár jóváhagyásra</strong>Amíg nem döntesz, nem hirdethetnek termékeket.</div>
                    <a class="btn btn-primary btn-sm" href="admin/producers">Árusok</a>
                </div>
            }

            @if (Auth.Role == "Admin")
            {
                <div class="lm-stats">
                    <StatCard Label="Jóváhagyásra váró árus" Value="@_pendingProducers.ToString()" IconName="users" CssClass="@(_pendingProducers > 0 ? "attention" : "tone-ok")" />
                    <StatCard Label="Vitatott rendelés" Value="@_orders.Count.ToString()" IconName="scale" CssClass="@(_orders.Count > 0 ? "attention" : "tone-ok")" />
                    <StatCard Label="Át nem vett rendelés" Value="@_unclaimed.ToString()" IconName="x-circle" CssClass="tone-bad" />
                    @if (_rate is not null)
                    {
                        <StatCard Label="Lemondott vagy elutasított" Value="@((_rate.CancelledOrders + _rate.RejectedOrders) + " / " + _rate.TotalOrders)" IconName="chart" CssClass="tone-info" />
                    }
                </div>
            }
            else
            {
                <div class="lm-stats">
                    <StatCard Label="Összes rendelés" Value="@_orders.Count.ToString()" IconName="receipt" CssClass="tone-info" />
                    <StatCard Label="Visszaigazolásra vár" Value="@Count("Pending").ToString()" IconName="clock" CssClass="@(Auth.Role == "Producer" && Count("Pending") > 0 ? "attention" : null)" />
                    <StatCard Label="Átvehető" Value="@Count("Ready").ToString()" IconName="package" CssClass="@(Count("Ready") > 0 ? "attention" : "tone-ok")" />
                    <StatCard Label="Átvéve" Value="@Count("PickedUp").ToString()" IconName="check-circle" CssClass="tone-ok" />
                </div>
            }

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="lm-card h-100">
                        <div class="lm-card-title">
                            <h2><Icon Name="@(Auth.Role == "Admin" ? "scale" : "receipt")" />@RecentTitle</h2>
                            <a class="lm-link-more" href="@AllOrdersHref">Mind<Icon Name="chevron-right" Size="16" /></a>
                        </div>
                        @if (_recent.Count == 0)
                        {
                            <p class="text-muted mb-0">@(Auth.Role == "Admin" ? "Nincs nyitott vita." : "Még nincs rendelés.")</p>
                        }
                        else
                        {
                            <div class="lm-order-list">
                                @foreach (var o in _recent)
                                {
                                    <OrderListItem Order="o" Href="@OrderHref(o)" ShowCustomer="@(Auth.Role != "Customer")" />
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="lm-card h-100">
                        <div class="lm-card-title"><h2><Icon Name="calendar" />Következő piacnap</h2></div>
                        @if (_nextMarket is null)
                        {
                            <p class="text-muted mb-0">Nincs aktív piac nyitvatartással.</p>
                        }
                        else
                        {
                            <div class="lm-next-market-date">@Labels.DateLong(_nextDay)</div>
                            <div class="mt-1 fw-bold">@_nextMarket.Name</div>
                            <div class="text-muted small">@_nextMarket.Address</div>
                            @if (_weather is { ForecastAvailable: true })
                            {
                                <div class="lm-weather">
                                    <span class="lm-weather-icon" aria-hidden="true"><Icon Name="@Labels.WeatherIcon(_weather)" /></span>
                                    <div>
                                        @if (_weather.TemperatureMinC is { } min && _weather.TemperatureMaxC is { } max)
                                        {
                                            <div class="lm-weather-temp">@Math.Round(min)–@Math.Round(max) °C</div>
                                        }
                                        <div class="small">
                                            @_weather.Description
                                            @if (_weather.PrecipitationMm is { } rain) { <span>, csapadék: @Labels.Qty((decimal)rain) mm</span> }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mt-3 mb-0">Az időjárás-előrejelzés még nem elérhető erre a napra.</p>
                            }
                        }
                    </div>
                </div>
            </div>

            @* Szerepkör-specifikus szekció *@
            @if (Auth.Role == "Customer" && _featured.Count > 0)
            {
                <div class="lm-section-title"><h2>Most rendelhető</h2><a class="lm-link-more" href="products">A teljes kínálat<Icon Name="chevron-right" Size="16" /></a></div>
                <div class="lm-grid">
                    @foreach (var p in _featured)
                    {
                        <ProductCard Product="p" />
                    }
                </div>
            }

            @if (Auth.Role == "Producer")
            {
                <div class="lm-card mt-4">
                    <div class="lm-card-title"><h2><Icon Name="warning" />Fogyó készlet</h2><a class="lm-link-more" href="vendor/products">Termékeim<Icon Name="chevron-right" Size="16" /></a></div>
                    @if (_lowStock.Count == 0)
                    {
                        <p class="text-muted mb-0">A heti kínálatodban egyik termékből sem fogy ki hamarosan a készlet.</p>
                    }
                    else
                    {
                        <ul class="lm-rank">
                            @foreach (var p in _lowStock)
                            {
                                var st = p.NextStock!;
                                var share = st.Quantity > 0 ? (int)Math.Clamp(Math.Round(st.AvailableQuantity / st.Quantity * 100), 0, 100) : 0;
                                <li>
                                    <div class="lm-rank-head"><a href="vendor/products/@p.Id"><strong>@p.Name</strong></a><span>@Labels.Qty(st.AvailableQuantity) / @Labels.Qty(st.Quantity) @Labels.Unit(st.Unit) maradt</span></div>
                                    <div class="lm-meter @(share == 0 ? "bad" : "low")" aria-hidden="true"><span style="width:@(share)%"></span></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (Auth.Role == "Admin" && _top.Count > 0)
            {
                var maxRevenue = _top.Max(t => t.TotalRevenue);
                <div class="lm-card mt-4">
                    <div class="lm-card-title"><h2><Icon Name="chart" />Legkeresettebb termékek</h2><a class="lm-link-more" href="admin/reports">Riportok<Icon Name="chevron-right" Size="16" /></a></div>
                    <ol class="lm-rank">
                        @foreach (var t in _top)
                        {
                            <li>
                                <div class="lm-rank-head"><strong>@t.ProductName</strong><span>@Labels.Money(t.TotalRevenue), @Labels.Qty(t.TotalQuantity) egység</span></div>
                                <div class="lm-meter" aria-hidden="true"><span style="width:@(maxRevenue > 0 ? (int)(t.TotalRevenue / maxRevenue * 100) : 0)%"></span></div>
                            </li>
                        }
                    </ol>
                </div>
            }

            <h2 class="visually-hidden">Gyors elérés</h2>
            <div class="lm-tiles mt-4">
                @foreach (var tile in Tiles)
                {
                    <a class="lm-tile" href="@tile.Href">
                        <Icon Name="@tile.Icon" />
                        <span class="lm-tile-text"><strong>@tile.Title</strong><span>@tile.Text</span></span>
                        <Icon Name="chevron-right" CssClass="chev" Size="18" />
                    </a>
                }
            </div>
        }
    </ChildContent>
</PageContainer>

@code {
    private IReadOnlyList<OrderInfo> _orders = [];
    private IReadOnlyList<OrderInfo> _recent = [];
    private IReadOnlyList<ProductInfo> _featured = [];
    private IReadOnlyList<ProductInfo> _lowStock = [];
    private IReadOnlyList<TopProductInfo> _top = [];
    private CancellationRateInfo? _rate;
    private ProducerInfo? _producer;
    private int _pendingProducers, _unclaimed;
    private MarketInfo? _nextMarket;
    private DateTime _nextDay;
    private MarketWeatherInfo? _weather;
    private ApiProblem? _problem;
    private bool _loading = true;

    private static string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour >= 4 && hour < 9) return "Jó reggelt!";
            return hour >= 9 && hour < 18 ? "Szép napot!" : "Jó estét!";
        }
    }

    private sealed record Tile(string Href, string Icon, string Title, string Text);

    private Tile[] Tiles => Auth.Role switch
    {
        "Admin" =>
        [
            new("admin/markets", "pin", "Piacok", "Nyitvatartás, cím, koordináta"),
            new("admin/categories", "tag", "Kategóriák", "Termékkategóriák kezelése"),
            new("admin/audit", "history", "Napló", "Kritikus módosítások nyoma"),
            new("profile", "user", "Profilom", "Adatok és jelszó"),
        ],
        "Producer" =>
        [
            new("vendor/products/new", "plus", "Új termék", "Meghirdetés és heti készlet"),
            new("vendor/slots", "clock", "Átvételi időpontok", "Mikor vehetik át a vásárlók"),
            new("vendor/picking-list", "clipboard", "Átvételi lista", "Napi összesítő letöltése"),
            new("profile", "user", "Profilom", "Gazdaság adatai, jelszó"),
        ],
        _ =>
        [
            new("products", "bag", "A heti kínálat", "Böngészés és kosárba tétel"),
            new("cart", "cart", "Kosár", "Átvételi időpont és rendelés"),
            new("orders", "receipt", "Rendeléseim", "Állapot, lemondás, export"),
            new("profile", "user", "Profilom", "Adatok és jelszó"),
        ]
    };

    private string RecentTitle => Auth.Role == "Admin" ? "Vitatott rendelések" : "Legutóbbi rendelések";
    private string AllOrdersHref => Auth.Role switch { "Admin" => "admin/disputes", "Producer" => "vendor/orders", _ => "orders" };
    private string OrderHref(OrderInfo o) => Auth.Role switch { "Admin" => "admin/disputes", "Producer" => $"vendor/orders/{o.Id}", _ => $"orders/{o.Id}" };

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        if (Auth.Role == "Admin")
        {
            var disputed = await Orders.DisputedAsync();
            var pending = await Catalog.ProducersAsync("Pending");
            _problem = disputed.Problem ?? pending.Problem;
            if (_problem is null) { _orders = disputed.Value!; _pendingProducers = pending.Value!.Count; }
        }
        else
        {
            var r = Auth.Role == "Producer" ? await Orders.ForProducerAsync(null) : await Orders.MineAsync(null);
            if (r.IsSuccess) _orders = r.Value!; else _problem = r.Problem;
        }
        _recent = _orders.OrderByDescending(o => o.CreatedAt).Take(4).ToList();

        // a kiegészítő kártyák hiba esetén egyszerűen elmaradnak
        if (_problem is null)
        {
            await LoadNextMarketDayAsync();
            await LoadRoleExtrasAsync();
        }
        _loading = false;
    }

    private async Task LoadRoleExtrasAsync()
    {
        if (Auth.Role == "Customer")
        {
            var products = await Catalog.SearchProductsAsync(null, null, []);
            _featured = products.Value?.Where(p => p.NextStock is { AvailableQuantity: > 0 }).Take(4).ToList() ?? [];
        }
        else if (Auth.Role == "Producer")
        {
            _producer = (await Vendor.GetMineAsync()).Value;
            if (Auth.ProducerId is { } producerId)
            {
                var products = await Catalog.ProductsOfProducerAsync(producerId);
                _lowStock = products.Value?.Where(p => p.NextStock is { AvailableQuantity: <= 5 }).Take(4).ToList() ?? [];
            }
        }
        else if (Auth.Role == "Admin")
        {
            _rate = (await Admin.CancellationRateAsync(null, null)).Value;
            _top = (await Admin.TopProductsAsync(null, null, 3)).Value ?? [];
            _unclaimed = (await Admin.UnclaimedAsync(null, null)).Value?.Count ?? 0;
        }
    }

    private async Task LoadNextMarketDayAsync()
    {
        var markets = (await Catalog.MarketsAsync()).Value?.Where(m => m.IsActive) ?? [];
        var today = DateTime.Today;
        var best = markets
            .Select(m => (Market: m, Day: NextOpeningDay(m, today)))
            .Where(x => x.Day is not null)
            .OrderBy(x => x.Day)
            .FirstOrDefault();
        if (best.Market is null) return;

        _nextMarket = best.Market;
        _nextDay = best.Day!.Value;
        _weather = (await Catalog.WeatherAsync(_nextMarket.Id, _nextDay)).Value;
    }

    private static DateTime? NextOpeningDay(MarketInfo market, DateTime today)
    {
        for (var i = 0; i < 7; i++)
        {
            var day = today.AddDays(i);
            if (market.OpeningDays.Contains(day.DayOfWeek.ToString())) return day;
        }
        return null;
    }

    private int Count(string status) => _orders.Count(o => o.Status == status);
}
