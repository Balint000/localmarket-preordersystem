@page "/cart"
@attribute [Authorize(Roles = "Customer")]
@inject CartService CartSvc
@inject ToastService Toasts

<PageTitle>Kosár – LocalMarket</PageTitle>

<PageContainer Title="Kosár" Subtitle="Termelőnként külön rendelés készül, mindegyikhez saját átvételi időponttal.">
    @if (_loading)
    {
        <LoadingIndicator Text="Kosár betöltése…" />
    }
    else if (_problem is not null && _cart is null)
    {
        <ErrorMessage Problem="_problem" OnRetry="LoadAsync" />
    }
    else if (_cart is null || _cart.Groups.Count == 0)
    {
        <EmptyState Title="A kosarad üres" Text="Nézz körül a heti kínálatban; amit kosárba teszel, itt találod." IconName="cart">
            <a class="btn btn-primary" href="products"><Icon Name="bag" />A heti kínálat</a>
        </EmptyState>
    }
    else
    {
        <CheckoutSteps Current="1" />

        @if (_problem is not null)
        {
            <ErrorMessage Problem="_problem" />
        }

        <div class="lm-split">
            <div>
                @foreach (var group in _cart.Groups)
                {
                    <section class="lm-card mb-3" aria-labelledby="grp-@group.ProducerId">
                        <div class="lm-card-title">
                            <h2 id="grp-@group.ProducerId"><Icon Name="store" />@(group.ProducerName ?? $"Termelő #{group.ProducerId}")</h2>
                            <span class="text-muted small">@group.Items.Count tétel</span>
                        </div>
                        <div class="lm-lines">
                            @foreach (var item in group.Items)
                            {
                                var busy = _busyProduct == item.ProductId;
                                <div class="lm-line @(busy ? "lm-busy" : "")">
                                    <div>
                                        <a class="lm-line-name" href="products/@item.ProductId">@item.ProductName</a>
                                        <div class="lm-line-sub">@Labels.Money(item.UnitPriceSnapshot) egységár</div>
                                    </div>
                                    <QuantityStepper Small="true" Value="item.Quantity" Min="@item.OrderStep" Step="@item.OrderStep" Disabled="busy"
                                                     Label="@($"{item.ProductName} mennyisége")" ValueChanged="v => ChangeAsync(item, v)" />
                                    <div class="d-flex align-items-center gap-1 justify-content-end">
                                        <span class="lm-line-total">@Labels.Money(item.LineTotal)</span>
                                        <button type="button" class="lm-icon-btn lm-line-actions" aria-label="@item.ProductName eltávolítása a kosárból" title="Eltávolítás"
                                                disabled="@busy" @onclick="() => RemoveAsync(item)"><Icon Name="trash" Size="18" /></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="lm-kv mt-2 pt-2 border-top"><span>Részösszeg</span><strong>@Labels.Money(group.Subtotal)</strong></div>
                    </section>
                }
            </div>

            <aside class="lm-card raised lm-sticky" aria-label="Összesítő">
                <h2 class="h5 mb-3">Összesítő</h2>
                @foreach (var group in _cart.Groups)
                {
                    <div class="lm-kv"><span>@(group.ProducerName ?? $"Termelő #{group.ProducerId}")</span><span>@Labels.Money(group.Subtotal)</span></div>
                }
                <div class="lm-summary"><span>Becsült végösszeg</span><span>@Labels.Money(_cart.EstimatedTotal)</span></div>
                <p class="text-muted small mt-2">A végleges árat és a készletet a rendelés leadásakor, az átvételi hét kínálata alapján rögzítjük.</p>
                <a class="btn btn-primary btn-lg w-100" href="checkout">Tovább az átvételhez<Icon Name="arrow-right" /></a>
                <a class="btn btn-link w-100 mt-1" href="products">Vásárlás folytatása</a>
            </aside>
        </div>
    }
</PageContainer>

@code {
    private CartInfo? _cart;
    private ApiProblem? _problem;
    private bool _loading = true;
    private int? _busyProduct;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        var result = await CartSvc.GetAsync();
        if (result.IsSuccess) _cart = result.Value; else _problem = result.Problem;
        _loading = false;
    }

    private async Task ChangeAsync(CartItemInfo item, decimal quantity)
    {
        if (_busyProduct is not null || quantity <= 0) return;
        _busyProduct = item.ProductId;
        _problem = null;
        var result = await CartSvc.SetQuantityAsync(item.ProductId, quantity);
        if (result.IsSuccess) _cart = result.Value;
        else { _problem = result.Problem; Toasts.Error(result.Problem!.Message); }
        _busyProduct = null;
    }

    private async Task RemoveAsync(CartItemInfo item)
    {
        if (_busyProduct is not null) return;
        _busyProduct = item.ProductId;
        _problem = null;
        var result = await CartSvc.RemoveAsync(item.ProductId);
        if (result.IsSuccess) { _cart = result.Value; Toasts.Success($"„{item.ProductName}” eltávolítva."); }
        else { _problem = result.Problem; Toasts.Error(result.Problem!.Message); }
        _busyProduct = null;
    }
}
