@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]
@inject CatalogApi Catalog
@inject AdminApi Admin
@inject ToastService Toasts

<PageTitle>Kategóriák – LocalMarket</PageTitle>

<PageContainer Title="Termékkategóriák" Subtitle="A termékek ezekbe a kategóriákba sorolhatók">
    <ChildContent>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="lm-card">
                    <div class="lm-card-title"><h2><Icon Name="@(_editId is null ? "plus" : "pencil")" />@(_editId is null ? "Új kategória" : "Kategória szerkesztése")</h2></div>
                    <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="category-form">
                        <DataAnnotationsValidator />
                        <div class="mb-2">
                            <label class="form-label" for="cat-name">Név</label>
                            <InputText id="cat-name" class="form-control" @bind-Value="_form.Name" maxlength="100" />
                            <ValidationMessage For="() => _form.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="cat-desc">Leírás</label>
                            <InputTextArea id="cat-desc" class="form-control" rows="2" @bind-Value="_form.Description" maxlength="500" />
                        </div>
                        <FormProblem Problem="_formProblem" />
                        <SubmitButton Busy="_busy" CssClass="btn-primary">@(_editId is null ? "Létrehozás" : "Mentés")</SubmitButton>
                        @if (_editId is not null) { <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Mégse</button> }
                    </EditForm>
                </div>
            </div>
            <div class="col-lg-7">
                @if (_loading) { <LoadingIndicator /> }
                else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
                else if (_items.Count == 0) { <EmptyState Title="Még nincs kategória" IconName="tag" Text="A termelők a termékeiket ezekbe sorolják; vegyél fel legalább egyet." /> }
                else
                {
                    <ul class="lm-list">
                        @foreach (var c in _items)
                        {
                            <li class="d-flex justify-content-between align-items-start gap-2">
                                <div><strong>@c.Name</strong>@if (!string.IsNullOrWhiteSpace(c.Description)) { <div class="small text-muted">@c.Description</div> }</div>
                                <div class="text-nowrap d-flex gap-1">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(c)"><Icon Name="pencil" Size="16" />Szerkesztés</button>
                                    <button type="button" class="lm-icon-btn" aria-label="@c.Name törlése" title="Törlés" @onclick="() => _deleting = c"><Icon Name="trash" Size="18" /></button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <ConfirmDialog Visible="_deleting is not null" Title="@($"Törlöd a(z) {_deleting?.Name} kategóriát?")" Danger="true" Busy="_busy"
                       Message="Ha még vannak termékek ebben a kategóriában, a törlés nem engedélyezett."
                       ConfirmText="Igen, törlöm" CancelText="Mégsem"
                       OnConfirm="DeleteAsync" OnCancel="() => _deleting = null" />
    </ChildContent>
</PageContainer>

@code {
    private sealed class CategoryForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A név megadása kötelező.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "Legfeljebb 100 karakter.")]
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    private readonly CategoryForm _form = new();
    private IReadOnlyList<CategoryInfo> _items = [];
    private ApiProblem? _problem, _formProblem;
    private bool _loading = true, _busy;
    private int? _editId;
    private CategoryInfo? _deleting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        var r = await Catalog.CategoriesAsync();
        if (r.IsSuccess) _items = r.Value!; else _problem = r.Problem;
        _loading = false;
    }

    private void StartEdit(CategoryInfo c)
    {
        _editId = c.Id; _form.Name = c.Name; _form.Description = c.Description; _formProblem = null;
    }

    private void CancelEdit()
    {
        _editId = null; _form.Name = ""; _form.Description = null; _formProblem = null;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true; _formProblem = null;
        var request = new CreateCategoryRequest(_form.Name.Trim(), _form.Description?.Trim());
        var r = _editId is int id
            ? await Admin.UpdateCategoryAsync(id, request)
            : await Admin.CreateCategoryAsync(request);
        if (r.IsSuccess)
        {
            Toasts.Success(_editId is null ? "Kategória létrehozva." : "Kategória módosítva.");
            CancelEdit();
            await LoadAsync();
        }
        else _formProblem = r.Problem;
        _busy = false;
    }

    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true;
        var r = await Admin.DeleteCategoryAsync(_deleting.Id);
        if (r.IsSuccess) { Toasts.Success("Kategória törölve."); if (_editId == _deleting.Id) CancelEdit(); await LoadAsync(); }
        else Toasts.Error(r.Problem!.Message);
        _deleting = null;
        _busy = false;
    }
}
