@page "/orders/{Id:int}"
@attribute [Authorize(Roles = "Customer")]
@inject OrdersApi Api
@inject FileDownloader Downloader
@inject ToastService Toasts

<PageTitle>Rendelés #@Id – LocalMarket</PageTitle>

<PageContainer Title="@(_order is null ? $"Rendelés #{Id}" : $"{_order.ProducerName ?? "Rendelés"} – #{Id}")" BackHref="orders" BackText="Rendeléseim"
               Subtitle="@(_order is null ? null : $"Leadva: {Labels.DateTimeText(_order.CreatedAt)}")">
    <Actions>
        @if (_order is not null)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@_exporting" @onclick='() => ExportAsync("Csv")'><Icon Name="download" />CSV</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@_exporting" @onclick='() => ExportAsync("Json")'><Icon Name="download" />JSON</button>
        }
    </Actions>
    <ChildContent>

    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (_problem is not null && _order is null)
    {
        <ErrorMessage Problem="_problem" OnRetry="LoadAsync" />
    }
    else if (_order is not null)
    {
        @if (_problem is not null)
        {
            <ErrorMessage Problem="_problem" />
        }

        @if (_order.Status == "Ready")
        {
            <div class="lm-callout ok"><Icon Name="check-circle" />
                <div class="lm-callout-body"><strong>Átvehető a standnál</strong>@Labels.DateLong(_order.PickupDate), @Labels.Time(_order.PickupStart)–@Labels.Time(_order.PickupEnd)</div>
            </div>
        }

        <div class="mb-4"><OrderProgress Status="@_order.Status" /></div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="lm-card">
                    <div class="lm-card-title"><h2><Icon Name="package" />Tételek</h2></div>
                    <OrderItemsTable Order="_order" />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="lm-card">
                    <div class="lm-card-title"><h2><Icon Name="info" />Részletek</h2></div>
                    <OrderInfoPanel Order="_order" />
                    @* A lemondhatóságot a backend dönti el; a gomb csak az aktív (még le nem zárt) állapotokban jelenik meg. *@
                    @if (_order.Status is "Pending" or "Accepted" or "PartiallyFulfilled" or "Ready")
                    {
                        <hr class="my-3" />
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _confirmCancel = true"><Icon Name="x-circle" />Rendelés lemondása</button>
                        <p class="small text-muted mt-2 mb-0">Elfogadott rendelést legkésőbb 12 órával az átvételi időpont előtt mondhatsz le; utána jelezd az árusnak.</p>
                    }
                    @* Vita csak lezárt átadás után nyitható (átvéve / nem átvett); a piacvezető dönt. *@
                    @if (CanDispute)
                    {
                        <hr class="my-3" />
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => { _disputeNote = string.Empty; _confirmDispute = true; }"><Icon Name="scale" />Probléma jelzése (vita)</button>
                    }
                </div>
            </div>
        </div>

        <ConfirmDialog Visible="_confirmCancel" Title="Lemondod a rendelést?" Danger="true" Busy="_busy"
                       Message="A lefoglalt készlet és az átvételi időpont felszabadul. Ezt nem lehet visszavonni."
                       ConfirmText="Igen, lemondom" CancelText="Megtartom"
                       OnConfirm="CancelAsync" OnCancel="() => _confirmCancel = false" />

        <ConfirmDialog Visible="_confirmDispute" Title="Probléma jelzése" Danger="true" Busy="_busy" IconName="scale"
                       Message="Írd le, mi nem stimmelt (pl. hiányzó tétel, nem adták ki a rendelést). A vitát a piacvezető dönti el."
                       ConfirmText="Vitát nyitok" CancelText="Mégse" ConfirmDisabled="string.IsNullOrWhiteSpace(_disputeNote)"
                       OnConfirm="DisputeAsync" OnCancel="() => _confirmDispute = false">
            <label class="form-label" for="dispute-note">Indoklás (kötelező, max. 1000 karakter)</label>
            <textarea id="dispute-note" class="form-control" rows="3" maxlength="1000" @bind="_disputeNote" @bind:event="oninput"></textarea>
        </ConfirmDialog>
    }
</ChildContent>
</PageContainer>

@code {
    [Parameter] public int Id { get; set; }

    private OrderInfo? _order;
    private ApiProblem? _problem;
    private bool _loading = true, _busy, _confirmCancel, _confirmDispute, _exporting;
    private string _disputeNote = string.Empty;

    // Vita: átvétel / „nem jött el” után, vagy ha az átvételi idősáv lejárt, de az árus nem zárta le az átadást
    // (pl. nem adta ki a rendelést). A piac helyi ideje számít; a végső döntést a backend hozza.
    private bool CanDispute => _order is { } o && (o.Status is "PickedUp" or "NotPickedUp"
        || (o.Status is "Accepted" or "PartiallyFulfilled" or "Ready" && MarketClock.Now >= o.PickupDate.Date.Add(o.PickupEnd.ToTimeSpan())));

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        var result = await Api.GetAsync(Id);
        if (result.IsSuccess) _order = result.Value; else { _order = null; _problem = result.Problem; }
        _loading = false;
    }

    private async Task CancelAsync()
    {
        if (_busy) return;
        _busy = true;
        var result = await Api.CancelAsync(Id);
        _confirmCancel = false;
        if (result.IsSuccess) { _order = result.Value; _problem = null; Toasts.Success("Rendelés lemondva."); }
        else { Toasts.Error(result.Problem!.Message); await LoadAsync(); }
        _busy = false;
    }

    private async Task DisputeAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_disputeNote)) return;
        _busy = true;
        var result = await Api.DisputeAsync(Id, _disputeNote.Trim());
        _confirmDispute = false;
        if (result.IsSuccess) { _order = result.Value; _problem = null; Toasts.Success("A vitát rögzítettük, a piacvezető dönt."); }
        else { Toasts.Error(result.Problem!.Message); await LoadAsync(); }
        _busy = false;
    }

    private async Task ExportAsync(string format)
    {
        if (_exporting) return;
        _exporting = true;
        var result = await Api.ExportOrderAsync(Id, format);
        if (result.IsSuccess) await Downloader.SaveAsync(result.Value!);
        else Toasts.Error(result.Problem!.Message);
        _exporting = false;
    }
}
