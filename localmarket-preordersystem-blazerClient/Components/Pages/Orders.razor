@page "/orders"
@attribute [Authorize(Roles = "Customer")]
@inject OrdersApi Api

<PageTitle>Rendeléseim – LocalMarket</PageTitle>

<PageContainer Title="Rendeléseim" Subtitle="Korábbi és aktív előrendeléseid">
    <NextPickupMap />
    <OrderListView Loader="s => Api.MineAsync(s)" DetailsBase="orders" EmptyText="A leadott rendeléseid itt követheted: mikor fogadta el a termelő, és mikor vehető át.">
        <EmptyContent><a class="btn btn-primary" href="products"><Icon Name="bag" />A heti kínálat</a></EmptyContent>
    </OrderListView>
</PageContainer>
