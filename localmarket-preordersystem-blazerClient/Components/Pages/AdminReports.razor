@page "/admin/reports"
@attribute [Authorize(Roles = "Admin")]
@inject AdminApi Admin
@inject OrdersApi Orders
@inject CatalogApi Catalog
@inject FileDownloader Downloader
@inject ToastService Toasts

<PageTitle>Riportok – LocalMarket</PageTitle>

<PageContainer Title="Riportok" Subtitle="Összesítések a kiválasztott időszakra.">
    <ChildContent>
        <form class="lm-filterbar" @onsubmit="LoadAsync" @onsubmit:preventDefault="true" aria-label="Időszak">
            <div class="lm-filterbar-row">
                <div><label class="form-label" for="r-from">Ettől</label><input id="r-from" type="date" class="form-control" @bind="_from" /></div>
                <div><label class="form-label" for="r-to">Eddig</label><input id="r-to" type="date" class="form-control" @bind="_to" /></div>
                <div class="d-flex gap-2 align-self-end flex-wrap">
                    <button type="submit" class="btn btn-primary" disabled="@_loading"><Icon Name="refresh" />Frissítés</button>
                    <button type="button" class="lm-pill" @onclick="() => PresetAsync(7)">Utolsó 7 nap</button>
                    <button type="button" class="lm-pill" @onclick="() => PresetAsync(30)">Utolsó 30 nap</button>
                </div>
            </div>
        </form>

        @if (_loading) { <LoadingIndicator /> }
        else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
        else
        {
            @if (_rate is not null)
            {
                <div class="lm-stats">
                    <StatCard Label="Összes rendelés" Value="@_rate.TotalOrders.ToString()" IconName="receipt" CssClass="tone-info" />
                    <StatCard Label="Lemondott" Value="@_rate.CancelledOrders.ToString()" IconName="x-circle" CssClass="tone-bad" />
                    <StatCard Label="Elutasított" Value="@_rate.RejectedOrders.ToString()" IconName="x-circle" CssClass="tone-bad" />
                    <StatCard Label="Lejárt (nem igazolt)" Value="@_rate.ExpiredOrders.ToString()" IconName="clock" CssClass="tone-bad" />
                    <StatCard Label="Lemondási arány" Value="@($"{Labels.Qty(RatePercent)}%")" IconName="chart" CssClass="@(RatePercent >= 15 ? "attention" : "tone-ok")" />
                </div>
            }
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="lm-card h-100">
                        <div class="lm-card-title"><h2><Icon Name="bag" />Legnépszerűbb termékek</h2><span class="small text-muted">bevétel szerint</span></div>
                        @if (_top.Count == 0) { <p class="text-muted mb-0">Ebben az időszakban nem volt rendelés.</p> }
                        else
                        {
                            var max = _top.Max(t => t.TotalRevenue);
                            <ol class="lm-rank">
                                @foreach (var t in _top)
                                {
                                    <li>
                                        <div class="lm-rank-head"><strong>@t.ProductName</strong><span>@Labels.Money(t.TotalRevenue)</span></div>
                                        <div class="lm-meter" aria-hidden="true"><span style="width:@Pct(t.TotalRevenue, max)%"></span></div>
                                        <div class="small text-muted">@Labels.Qty(t.TotalQuantity) egység, @t.OrderCount rendelésben</div>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="lm-card h-100">
                        <div class="lm-card-title"><h2><Icon Name="store" />Árusok bevétele</h2></div>
                        @if (_revenue.Count == 0) { <p class="text-muted mb-0">Ebben az időszakban nem volt bevétel.</p> }
                        else
                        {
                            var max = _revenue.Max(v => v.Revenue);
                            <ol class="lm-rank">
                                @foreach (var v in _revenue.OrderByDescending(v => v.Revenue))
                                {
                                    <li>
                                        <div class="lm-rank-head"><strong>@v.ProducerName</strong><span>@Labels.Money(v.Revenue)</span></div>
                                        <div class="lm-meter" aria-hidden="true"><span style="width:@Pct(v.Revenue, max)%"></span></div>
                                        <div class="small text-muted">@v.OrderCount rendelés</div>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>
                <div class="col-12">
                    <div class="lm-card">
                        <div class="lm-card-title"><h2><Icon Name="x-circle" />Át nem vett rendelések</h2></div>
                        @if (_unclaimed.Count == 0) { <p class="text-muted mb-0">Ebben az időszakban minden rendelést átvettek.</p> }
                        else
                        {
                            <div class="table-responsive border-0"><table class="table lm-table mb-0"><thead><tr><th>Rendelés</th><th>Árus</th><th>Vásárló</th><th>Átvétel napja</th><th class="text-end">Összeg</th><th>Állapot</th></tr></thead>
                            <tbody>@foreach (var u in _unclaimed) { <tr><td>#@u.OrderId</td><td>@u.ProducerName</td><td>@u.CustomerName</td><td>@Labels.DateShort(u.PickupDate)</td><td class="text-end">@Labels.Money(u.TotalAmount)</td><td><StatusBadge Status="@u.Status" /></td></tr> }</tbody></table></div>
                        }
                    </div>
                </div>
                <div class="col-12">
                    <div class="lm-card">
                        <div class="lm-card-title"><h2><Icon Name="clipboard" />Piacnapi szedési lista</h2><span class="small text-muted">elfogadott rendelések, árusonként</span></div>
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4"><label class="form-label" for="pl-day">Átvétel napja</label><input id="pl-day" type="date" class="form-control" @bind="_pickDate" /></div>
                            <div class="col-sm-4">
                                <label class="form-label" for="pl-producer">Árus</label>
                                <select id="pl-producer" class="form-select" @bind="_pickProducer">
                                    <option value="">Minden árus</option>
                                    @foreach (var p in _producers) { <option value="@p.Id">@p.Name</option> }
                                </select>
                            </div>
                            <div class="col-sm-4 d-flex gap-2">
                                <button type="button" class="btn btn-primary" disabled="@_exporting" @onclick='() => ExportPickingAsync("Csv")'><Icon Name="download" />CSV</button>
                                <button type="button" class="btn btn-outline-primary" disabled="@_exporting" @onclick='() => ExportPickingAsync("Json")'><Icon Name="download" />JSON</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</PageContainer>

@code {
    private DateTime? _from = DateTime.Today.AddDays(-30), _to = DateTime.Today;
    private CancellationRateInfo? _rate;
    private IReadOnlyList<TopProductInfo> _top = [];
    private IReadOnlyList<VendorRevenueInfo> _revenue = [];
    private IReadOnlyList<UnclaimedOrderInfo> _unclaimed = [];
    private ApiProblem? _problem;
    private bool _loading = true, _exporting;
    private IReadOnlyList<ProducerInfo> _producers = [];
    private DateTime _pickDate = DateTime.Today;
    private string _pickProducer = "";

    // az API arányt (0–1) vagy már százalékot is adhat; a megjelenítés mindkettőt kezeli
    private decimal RatePercent => _rate is null ? 0 : Math.Round(_rate.Rate <= 1 ? _rate.Rate * 100 : _rate.Rate, 1);

    private static int Pct(decimal value, decimal max) => max > 0 ? (int)Math.Clamp(value / max * 100, 0, 100) : 0;

    private async Task PresetAsync(int days)
    {
        _from = DateTime.Today.AddDays(-days);
        _to = DateTime.Today;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var producers = await Catalog.ProducersAsync("Approved");
        if (producers.IsSuccess) _producers = producers.Value!;
        await LoadAsync();
    }

    private async Task ExportPickingAsync(string format)
    {
        if (_exporting) return;
        _exporting = true;
        int? producerId = int.TryParse(_pickProducer, out var id) ? id : null;
        var result = await Orders.ExportPickingListAsync(_pickDate, format, producerId);
        if (result.IsSuccess) await Downloader.SaveAsync(result.Value!);
        else Toasts.Error(result.Problem!.Message);
        _exporting = false;
    }

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        var rate = Admin.CancellationRateAsync(_from, _to);
        var top = Admin.TopProductsAsync(_from, _to);
        var rev = Admin.VendorRevenueAsync(_from, _to);
        var unc = Admin.UnclaimedAsync(_from, _to);
        await Task.WhenAll(rate, top, rev, unc);
        _problem = rate.Result.Problem ?? top.Result.Problem ?? rev.Result.Problem ?? unc.Result.Problem;
        if (_problem is null) { _rate = rate.Result.Value; _top = top.Result.Value!; _revenue = rev.Result.Value!; _unclaimed = unc.Result.Value!; }
        _loading = false;
    }
}
