@page "/products"
@implements IDisposable
@inject CatalogApi Catalog

<PageTitle>Termékek – LocalMarket</PageTitle>

<PageContainer Title="A heti kínálat" Subtitle="Válogass a termelők aktuális heti kínálatából.">
    <form class="lm-filterbar" role="search" aria-label="Termékek szűrése" @onsubmit="SearchNowAsync" @onsubmit:preventDefault="true">
        <div class="lm-filterbar-row">
            <div class="lm-input-group">
                <Icon Name="search" />
                <input id="text" type="search" class="form-control" placeholder="Keresés, pl. paradicsom" aria-label="Keresés terméknévre"
                       value="@_text" @oninput="OnTextInputAsync" autocomplete="off" />
            </div>
            @if (_markets.Count > 1)
            {
                <label class="visually-hidden" for="market">Piac</label>
                <select id="market" class="form-select" value="@(_marketId?.ToString() ?? "")" @onchange="OnMarketChangedAsync" aria-label="Piac">
                    <option value="">Minden piac</option>
                    @foreach (var m in _markets) { <option value="@m.Id">@m.Name</option> }
                </select>
            }
            <label class="visually-hidden" for="producer">Árus</label>
            <select id="producer" class="form-select" value="@(_producerId?.ToString() ?? "")" @onchange="OnProducerChangedAsync" aria-label="Árus">
                <option value="">Minden árus</option>
                @foreach (var p in VisibleProducers) { <option value="@p.Id">@p.Name@(p.StallNumber > 0 ? $" ({p.StallNumber}. stand)" : "")</option> }
            </select>
            <label class="visually-hidden" for="sort">Rendezés</label>
            <select id="sort" class="form-select" @bind="_sort">
                <option value="name">Név szerint (A–Z)</option>
                <option value="price-asc">Ár szerint növekvő</option>
                <option value="price-desc">Ár szerint csökkenő</option>
                <option value="available">Elérhetők elöl</option>
            </select>
        </div>

        @if (_categories.Count > 0)
        {
            <div>
                <div class="lm-filter-label" id="cat-label">Kategória</div>
                <div class="lm-pills scroll" role="group" aria-labelledby="cat-label">
                    <button type="button" class="lm-pill" aria-pressed="@(_categoryId is null ? "true" : "false")" @onclick="() => SetCategoryAsync(null)">Mind</button>
                    @foreach (var c in _categories)
                    {
                        var id = c.Id;
                        <button type="button" class="lm-pill" aria-pressed="@(_categoryId == id ? "true" : "false")" @onclick="() => SetCategoryAsync(id)">@c.Name</button>
                    }
                </div>
            </div>
        }

        <div>
            <div class="lm-filter-label" id="allergy-label">Ne tartalmazza</div>
            <div class="lm-pills" role="group" aria-labelledby="allergy-label">
                @foreach (var a in Labels.Allergies)
                {
                    var allergy = a;
                    <button type="button" class="lm-pill exclude" aria-pressed="@(_excluded.Contains(allergy) ? "true" : "false")" @onclick="() => ToggleAllergyAsync(allergy)">@Labels.Allergy(allergy)</button>
                }
            </div>
        </div>
    </form>

    @if (_problem is not null)
    {
        <ErrorMessage Problem="_problem" OnRetry="SearchNowAsync" />
    }
    else if (_firstLoad)
    {
        <ProductGridSkeleton />
    }
    else
    {
        <div class="lm-results-meta">
            <span role="status" aria-live="polite">
                @if (_loading) { <span>Keresés…</span> }
                else { <span>@_products.Count termék@(HasFilters ? " a szűrésnek megfelelően" : "")</span> }
            </span>
            @if (HasFilters)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="ClearFiltersAsync"><Icon Name="filter-x" Size="16" />Szűrők törlése</button>
            }
        </div>

        @if (_products.Count == 0 && !_loading)
        {
            <EmptyState Title="Nincs ilyen termék a heti kínálatban" IconName="search"
                        Text="Próbálj rövidebb keresőszót, vagy lazíts a szűrőkön.">
                @if (HasFilters) { <button type="button" class="btn btn-outline-primary" @onclick="ClearFiltersAsync">Szűrők törlése</button> }
            </EmptyState>
        }
        else
        {
            <div class="lm-grid @(_loading ? "lm-busy" : "")" aria-busy="@(_loading ? "true" : "false")">
                @foreach (var product in Sorted())
                {
                    <ProductCard @key="product.Id" Product="product" />
                }
            </div>
        }
    }
</PageContainer>

@code {
    private readonly HashSet<string> _excluded = [];
    private IReadOnlyList<CategoryInfo> _categories = [];
    private IReadOnlyList<ProductInfo> _products = [];
    private ApiProblem? _problem;
    private bool _loading = true, _firstLoad = true;
    private string _sort = "name";
    private string _text = "";
    private int? _categoryId;
    private int? _marketId, _producerId;
    private IReadOnlyList<MarketInfo> _markets = [];
    private IReadOnlyList<ProducerInfo> _producers = [];

    // piacválasztás után csak az adott piac árusai választhatók
    private IEnumerable<ProducerInfo> VisibleProducers =>
        (_marketId is int m ? _producers.Where(p => p.MarketId == m) : _producers).OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase);

    private CancellationTokenSource? _debounce;
    private int _requestVersion;

    private bool HasFilters => !string.IsNullOrWhiteSpace(_text) || _categoryId is not null || _excluded.Count > 0
                               || _marketId is not null || _producerId is not null;

    [SupplyParameterFromQuery(Name = "marketId")] public int? MarketIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "producerId")] public int? ProducerIdQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _marketId = MarketIdQuery;
        _producerId = ProducerIdQuery;
        var categories = Catalog.CategoriesAsync();
        var markets = Catalog.MarketsAsync();
        var producers = Catalog.ProducersAsync();
        await Task.WhenAll(categories, markets, producers);
        if (categories.Result.IsSuccess) _categories = categories.Result.Value!;
        if (markets.Result.IsSuccess) _markets = markets.Result.Value!.Where(m => m.IsActive).ToList();
        if (producers.Result.IsSuccess) _producers = producers.Result.Value!;
        await SearchAsync();
    }

    private async Task OnMarketChangedAsync(ChangeEventArgs e)
    {
        _marketId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        // más piac árusa nem maradhat kiválasztva
        if (_producerId is int p && _marketId is int m && _producers.FirstOrDefault(x => x.Id == p)?.MarketId != m) _producerId = null;
        await SearchNowAsync();
    }

    private async Task OnProducerChangedAsync(ChangeEventArgs e)
    {
        _producerId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await SearchNowAsync();
    }

    // gépelés közben kis késleltetéssel keresünk, hogy ne menjen kérés minden leütésre
    private async Task OnTextInputAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(350, token); }
        catch (TaskCanceledException) { return; }
        await SearchAsync();
    }

    private async Task SearchNowAsync()
    {
        _debounce?.Cancel();
        await SearchAsync();
    }

    private async Task SetCategoryAsync(int? id)
    {
        if (_categoryId == id) return;
        _categoryId = id;
        await SearchNowAsync();
    }

    private async Task ToggleAllergyAsync(string allergy)
    {
        if (!_excluded.Remove(allergy)) _excluded.Add(allergy);
        await SearchNowAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _text = "";
        _categoryId = null;
        _marketId = null;
        _producerId = null;
        _excluded.Clear();
        await SearchNowAsync();
    }

    private async Task SearchAsync()
    {
        // csak a legutóbbi kérés eredménye jelenhet meg (a válaszok sorrendje nem garantált)
        var version = ++_requestVersion;
        _loading = true;
        _problem = null;
        var result = await Catalog.SearchProductsAsync(_text, _categoryId, _excluded.ToList(), _marketId, _producerId);
        if (version != _requestVersion) return;

        if (result.IsSuccess) _products = result.Value!;
        else _problem = result.Problem;
        _loading = false;
        _firstLoad = false;
    }

    // a backend nem rendez: a már letöltött listát a kliens rendezi (csak megjelenítés)
    private IEnumerable<ProductInfo> Sorted() => _sort switch
    {
        "price-asc" => _products.OrderBy(p => p.NextStock?.UnitPrice ?? decimal.MaxValue),
        "price-desc" => _products.OrderByDescending(p => p.NextStock?.UnitPrice ?? decimal.MinValue),
        "available" => _products.OrderByDescending(p => p.NextStock is { AvailableQuantity: > 0 }).ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase),
        _ => _products.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
    };

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
