@page "/checkout"
@attribute [Authorize(Roles = "Customer")]
@inject CartService CartSvc
@inject CatalogApi Catalog
@inject OrdersApi Orders
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Rendelés leadása – LocalMarket</PageTitle>

<PageContainer Title="Átvétel és fizetés" Subtitle="Válassz átvételi időpontot minden termelőnél, aztán add le a rendelést." BackHref="cart" BackText="Vissza a kosárhoz">
    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (_loadProblem is not null)
    {
        <ErrorMessage Problem="_loadProblem" OnRetry="LoadAsync" />
    }
    else if (_cart is null || _cart.Groups.Count == 0)
    {
        <EmptyState Title="A kosarad üres" Text="Rendelést csak nem üres kosárból lehet leadni." IconName="cart">
            <a class="btn btn-primary" href="products"><Icon Name="bag" />A heti kínálat</a>
        </EmptyState>
    }
    else
    {
        <CheckoutSteps Current="2" />

        <EditForm Model="this" OnSubmit="SubmitAsync" FormName="checkout">
            @if (_problem is not null)
            {
                <ErrorMessage Problem="_problem" />
            }
            @if (_submitted && MissingCount > 0)
            {
                <div class="lm-callout warn" role="alert"><Icon Name="warning" /><div class="lm-callout-body">Még @MissingCount termelőnél nincs kiválasztva átvételi időpont.</div></div>
            }

            <div class="lm-split">
                <div>
                    @foreach (var group in _cart.Groups)
                    {
                        var slots = (_slots.GetValueOrDefault(group.ProducerId) ?? []).OrderBy(x => x.Date).ThenBy(x => x.StartTime).ToList();
                        var producerId = group.ProducerId;
                        var missing = _submitted && _selected.GetValueOrDefault(producerId) == 0;
                        <section class="lm-card mb-3" aria-labelledby="co-@producerId">
                            <div class="lm-card-title">
                                <h2 id="co-@producerId"><Icon Name="store" />@(group.ProducerName ?? $"Termelő #{producerId}")</h2>
                                <span class="text-muted small">@Labels.Money(group.Subtotal)</span>
                            </div>
                            <p class="small text-muted">@string.Join(", ", group.Items.Select(i => $"{i.ProductName} × {Labels.Qty(i.Quantity)}"))</p>

                            @if (_slotProblems.TryGetValue(producerId, out var slotProblem))
                            {
                                <ErrorMessage Problem="slotProblem" OnRetry="LoadAsync" />
                            }
                            else if (slots.Count == 0)
                            {
                                <div class="lm-callout warn mb-0"><Icon Name="warning" /><div class="lm-callout-body">Ennél a termelőnél most nincs szabad átvételi időpont, ezért ez a rendelés nem adható le. Vedd ki a termékeit a kosárból, vagy nézz vissza később.</div></div>
                            }
                            else
                            {
                                <fieldset>
                                    <legend class="form-label">Átvételi időpont</legend>
                                    <div class="lm-choices">
                                        @foreach (var slot in slots)
                                        {
                                            var slotId = slot.Id;
                                            var full = slot.FreeCapacity <= 0 || !slot.IsBookable;
                                            <label class="lm-choice">
                                                <input type="radio" name="slot-@producerId" value="@slotId" disabled="@full"
                                                       checked="@(_selected.GetValueOrDefault(producerId) == slotId)" @onchange="() => _selected[producerId] = slotId" />
                                                <span class="lm-choice-body">
                                                    <span class="lm-choice-title">@Labels.DateShort(slot.Date), @Labels.DayRelative(slot.Date)</span>
                                                    <span>@Labels.Time(slot.StartTime)–@Labels.Time(slot.EndTime)</span>
                                                    <span class="lm-choice-sub">@(!slot.IsBookable && slot.FreeCapacity > 0 ? "Nem foglalható (a piac zárva)" : full ? "Betelt" : $"{slot.FreeCapacity} szabad hely")</span>
                                                </span>
                                                <span class="lm-choice-check" aria-hidden="true"><Icon Name="check" /></span>
                                            </label>
                                        }
                                    </div>
                                    @if (missing)
                                    {
                                        <div class="validation-message">Válassz átvételi időpontot.</div>
                                    }
                                </fieldset>
                            }
                        </section>
                    }

                    <section class="lm-card" aria-labelledby="pay-title">
                        <fieldset>
                            <legend id="pay-title" class="h6 mb-3">Fizetési mód</legend>
                            <div class="lm-choices lg">
                                @foreach (var method in Labels.PaymentMethods)
                                {
                                    var m = method;
                                    <label class="lm-choice">
                                        <input type="radio" name="payment" value="@m" checked="@(_payment == m)" @onchange="() => _payment = m" />
                                        <span class="lm-choice-body">
                                            <span class="lm-choice-title"><Icon Name="@Labels.PaymentIcon(m)" />@Labels.Payment(m)</span>
                                            <span class="lm-choice-sub">@Labels.PaymentHint(m)</span>
                                        </span>
                                        <span class="lm-choice-check" aria-hidden="true"><Icon Name="check" /></span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    </section>
                </div>

                <aside class="lm-card raised lm-sticky" aria-label="Összesítő">
                    <h2 class="h5 mb-3">Összesítő</h2>
                    @foreach (var group in _cart.Groups)
                    {
                        var chosen = (_slots.GetValueOrDefault(group.ProducerId) ?? []).FirstOrDefault(x => x.Id == _selected.GetValueOrDefault(group.ProducerId));
                        <div class="lm-kv">
                            <span>
                                @(group.ProducerName ?? $"Termelő #{group.ProducerId}")
                                <span class="d-block small @(chosen is null && _submitted ? "text-danger" : "text-muted")">@(chosen is null ? "Nincs időpont kiválasztva" : $"{Labels.DateShort(chosen.Date)} {Labels.Time(chosen.StartTime)}–{Labels.Time(chosen.EndTime)}")</span>
                            </span>
                            <span>@Labels.Money(group.Subtotal)</span>
                        </div>
                    }
                    <div class="lm-summary"><span>Becsült végösszeg</span><span>@Labels.Money(_cart.EstimatedTotal)</span></div>
                    <p class="text-muted small mt-2">A végső összeget és a készletfoglalást a rendelés leadásakor rögzítjük. Online fizetés nincs.</p>
                    <SubmitButton Busy="_busy" CssClass="btn-primary btn-lg w-100">@(_cart.Groups.Count > 1 ? $"{_cart.Groups.Count} rendelés leadása" : "Rendelés leadása")</SubmitButton>
                </aside>
            </div>
        </EditForm>
    }
</PageContainer>

@code {
    private CartInfo? _cart;
    private readonly Dictionary<int, IReadOnlyList<PickupSlotInfo>> _slots = new();
    private readonly Dictionary<int, ApiProblem> _slotProblems = new();
    private readonly Dictionary<int, int> _selected = new();
    private string _payment = "Cash";
    private ApiProblem? _loadProblem, _problem;
    private bool _loading = true, _busy, _submitted;

    private int MissingCount => _cart?.Groups.Count(g => _selected.GetValueOrDefault(g.ProducerId) == 0) ?? 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadProblem = null;
        _slotProblems.Clear();

        var cart = await CartSvc.GetAsync();
        if (!cart.IsSuccess) { _loadProblem = cart.Problem; _loading = false; return; }
        _cart = cart.Value;

        foreach (var group in _cart!.Groups)
        {
            _selected.TryAdd(group.ProducerId, 0);
            var slots = await Catalog.PickupSlotsAsync(group.ProducerId);
            if (slots.IsSuccess) _slots[group.ProducerId] = slots.Value!;
            else _slotProblems[group.ProducerId] = slots.Problem!;
        }
        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_busy || _cart is null || _cart.Groups.Count == 0) return;
        _submitted = true;
        _problem = null;

        if (_cart.Groups.Any(g => _selected.GetValueOrDefault(g.ProducerId) == 0)) return;

        _busy = true;
        var pickups = _cart.Groups.Select(g => new PickupChoiceRequest(g.ProducerId, _selected[g.ProducerId])).ToList();
        var result = await Orders.PlaceAsync(new PlaceOrderRequest(_payment, pickups));

        if (result.IsSuccess)
        {
            var placed = result.Value!;
            Toasts.Success(placed.Count == 1 ? "A rendelésedet leadtuk." : $"{placed.Count} rendelést adtunk le (termelőnként egyet).");
            Navigation.NavigateTo(placed.Count == 1 ? $"orders/{placed[0].Id}" : "orders");
            return;
        }

        _problem = result.Problem;
        if (result.Problem!.Kind is ApiFailure.Conflict or ApiFailure.BadRequest or ApiFailure.Validation)
            await LoadAsync(); // a kosár/foglaltság közben megváltozhatott
        _busy = false;
    }
}
