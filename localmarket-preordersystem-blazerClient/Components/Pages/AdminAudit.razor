@page "/admin/audit"
@attribute [Authorize(Roles = "Admin")]
@inject AdminApi Admin

<PageTitle>Napló – LocalMarket</PageTitle>

<PageContainer Title="Auditnapló" Subtitle="A rendelések, termékek, árusok és piacok módosításainak nyoma">
    <ChildContent>
        <div class="lm-card mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-sm-6 col-md-4">
                    <label class="form-label" for="audit-entity">Entitás típusa</label>
                    <select id="audit-entity" class="form-select" value="@_entity" @onchange="OnEntityChanged">
                        <option value="">Mind</option>
                        @foreach (var e in Entities) { <option value="@e">@e</option> }
                    </select>
                </div>
            </div>
        </div>

        @if (_loading) { <LoadingIndicator /> }
        else if (_problem is not null) { <ErrorMessage Problem="_problem" OnRetry="LoadAsync" /> }
        else if (_page is null || _page.Items.Count == 0) { <EmptyState Title="Nincs naplóbejegyzés" /> }
        else
        {
            <div class="table-responsive">
                <table class="table lm-table">
                    <thead><tr><th>Időpont</th><th>Művelet</th><th>Entitás</th><th>Felhasználó</th><th>Változás</th></tr></thead>
                    <tbody>
                    @foreach (var l in _page.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@l.CreatedAt.ToLocalTime().ToString("yyyy. MM. dd. HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@l.Action</td>
                            <td>@l.EntityName #@l.EntityId</td>
                            <td>@(l.UserId?.ToString() ?? "–")</td>
                            <td class="small text-break">
                                @if (!string.IsNullOrWhiteSpace(l.OldValue)) { <div><span class="text-muted">régi:</span> @l.OldValue</div> }
                                @if (!string.IsNullOrWhiteSpace(l.NewValue)) { <div><span class="text-muted">új:</span> @l.NewValue</div> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_page.Page <= 1)" @onclick="() => GoToAsync(_page.Page - 1)">← Előző</button>
                <span class="small text-muted">@_page.Page. oldal, összesen @_page.Total bejegyzés</span>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_page.Page * _page.PageSize >= _page.Total)" @onclick="() => GoToAsync(_page.Page + 1)">Következő →</button>
            </div>
        }
    </ChildContent>
</PageContainer>

@code {
    private static readonly string[] Entities = ["Order", "Product", "Producer", "Market", "Category", "PickupSlot"];

    private PagedResult<AuditLogInfo>? _page;
    private ApiProblem? _problem;
    private bool _loading = true;
    private string _entity = "";
    private int _pageNumber = 1;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnEntityChanged(ChangeEventArgs e)
    {
        _entity = e.Value?.ToString() ?? "";
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task GoToAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _problem = null;
        var r = await Admin.AuditAsync(string.IsNullOrEmpty(_entity) ? null : _entity, _pageNumber);
        if (r.IsSuccess) _page = r.Value; else _problem = r.Problem;
        _loading = false;
    }
}
