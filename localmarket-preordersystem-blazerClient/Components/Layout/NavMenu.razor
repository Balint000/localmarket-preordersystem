@implements IDisposable
@inject AuthStateService Auth
@inject CartService Cart
@inject NavigationManager Navigation

<header class="lm-header">
    <div class="container lm-header-inner">
        <a class="lm-brand" href="@(Auth.IsAuthenticated ? "dashboard" : "")" aria-label="LocalMarket kezdőlap">
            <span class="lm-brand-mark" aria-hidden="true">LM</span>
            <span>LocalMarket</span>
        </a>

        <button type="button" class="lm-menu-toggle" aria-label="Menü" aria-expanded="@_open" aria-controls="lm-nav" @onclick="() => _open = !_open">
            <span aria-hidden="true">☰</span>
        </button>

        <nav id="lm-nav" class="lm-nav @(_open ? "open" : "")" aria-label="Főmenü" @onclick="() => _open = false">
            <NavLink class="lm-nav-link" href="products">Termékek</NavLink>

            <AuthorizeView Roles="Customer">
                <NavLink class="lm-nav-link" href="dashboard">Irányítópult</NavLink>
                <NavLink class="lm-nav-link" href="orders">Rendeléseim</NavLink>
                <NavLink class="lm-nav-link" href="cart">
                    Kosár
                    @if (Cart.ItemCount > 0)
                    {
                        <span class="lm-cart-badge" aria-label="@Cart.ItemCount tétel a kosárban">@Cart.ItemCount</span>
                    }
                </NavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Producer">
                <NavLink class="lm-nav-link" href="dashboard">Irányítópult</NavLink>
                <NavLink class="lm-nav-link" href="vendor/orders">Beérkező rendelések</NavLink>
            </AuthorizeView>
            <AuthorizeView Roles="MarketManager">
                <NavLink class="lm-nav-link" href="dashboard">Irányítópult</NavLink>
                <NavLink class="lm-nav-link" href="manager/disputes">Viták</NavLink>
            </AuthorizeView>

            <span class="lm-nav-spacer"></span>

            <AuthorizeView>
                <Authorized>
                    <UserMenu />
                </Authorized>
                <NotAuthorized>
                    <NavLink class="lm-nav-link" href="login">Bejelentkezés</NavLink>
                    <a class="btn btn-primary btn-sm" href="register">Regisztráció</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthChanged;
        Cart.Changed += OnCartChanged;
        await RefreshCartCountAsync();
    }

    private void OnAuthChanged(Task<AuthenticationState> state) => _ = InvokeAsync(async () =>
    {
        await RefreshCartCountAsync();
        StateHasChanged();
    });

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    // a navbar-számláló a kosár tényleges (szerver oldali) tartalmából jön, nem kliensoldali számolásból
    private async Task RefreshCartCountAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        if (Auth.Role == "Customer") await Cart.GetAsync();
        else Cart.Reset();
    }

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthChanged;
        Cart.Changed -= OnCartChanged;
    }
}
