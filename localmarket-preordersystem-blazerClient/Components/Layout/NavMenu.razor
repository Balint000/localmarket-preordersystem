@implements IDisposable
@inject AuthStateService Auth
@inject CartService Cart
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>
        @* mobil sáv: márka, kosár (vásárló), menü *@
        <header class="lm-mobilebar">
            <a class="lm-brand" href="dashboard" aria-label="LocalMarket áttekintés">
                <span class="lm-brand-mark"><Icon Name="leaf" /></span>
                <span>LocalMarket</span>
            </a>
            @if (Auth.Role == "Customer")
            {
                <a class="lm-icon-btn" href="cart" aria-label="@CartLabel">
                    <Icon Name="cart" />
                    @if (Cart.ItemCount > 0) { <span @key="Cart.ItemCount" class="lm-count bump" aria-hidden="true">@Cart.ItemCount</span> }
                </a>
            }
            <button type="button" id="lm-menu-button" class="lm-icon-btn" aria-label="Menü megnyitása" aria-expanded="@(_open ? "true" : "false")"
                    aria-controls="lm-sidebar" @onclick="OpenAsync">
                <Icon Name="menu" />
            </button>
        </header>

        @if (_open)
        {
            <div class="lm-scrim" @onclick="CloseAsync" aria-hidden="true"></div>
        }

        <aside id="lm-sidebar" class="lm-sidebar @(_open ? "open" : "")" aria-label="Oldalsáv" @onkeydown="OnKeyDown">
            <div class="lm-sidebar-head">
                <a class="lm-brand" href="dashboard" aria-label="LocalMarket áttekintés">
                    <span class="lm-brand-mark"><Icon Name="leaf" /></span>
                    <span>LocalMarket</span>
                </a>
                <button type="button" id="lm-sidebar-close" class="lm-icon-btn lm-sidebar-close" aria-label="Menü bezárása" @onclick="CloseAsync">
                    <Icon Name="x" />
                </button>
            </div>

            <nav class="lm-side-nav" aria-label="Főmenü">
                <div class="lm-side-group">
                    <NavLink class="lm-side-link" href="dashboard" Match="NavLinkMatch.All"><Icon Name="home" /><span>Áttekintés</span></NavLink>
                </div>

                @switch (Auth.Role)
                {
                    case "Customer":
                        <div class="lm-side-group" role="group" aria-labelledby="ng-shop">
                            <div class="lm-side-group-title" id="ng-shop">Vásárlás</div>
                            <NavLink class="lm-side-link" href="products"><Icon Name="bag" /><span>Termékek</span></NavLink>
                            <NavLink class="lm-side-link" href="markets"><Icon Name="pin" /><span>Piacok</span></NavLink>
                            <NavLink class="lm-side-link" href="cart" Match="NavLinkMatch.All">
                                <Icon Name="cart" /><span>Kosár</span>
                                @if (Cart.ItemCount > 0) { <span @key="Cart.ItemCount" class="lm-count bump"><span class="visually-hidden">tételek száma: </span>@Cart.ItemCount</span> }
                            </NavLink>
                            <NavLink class="lm-side-link" href="orders"><Icon Name="receipt" /><span>Rendeléseim</span></NavLink>
                        </div>
                        break;

                    case "Producer":
                        <div class="lm-side-group" role="group" aria-labelledby="ng-orders">
                            <div class="lm-side-group-title" id="ng-orders">Rendelések</div>
                            <NavLink class="lm-side-link" href="vendor/orders"><Icon Name="inbox" /><span>Beérkező rendelések</span></NavLink>
                            <NavLink class="lm-side-link" href="vendor/picking-list"><Icon Name="clipboard" /><span>Átvételi lista</span></NavLink>
                        </div>
                        <div class="lm-side-group" role="group" aria-labelledby="ng-offer">
                            <div class="lm-side-group-title" id="ng-offer">Kínálat</div>
                            <NavLink class="lm-side-link" href="vendor/products"><Icon Name="sprout" /><span>Termékeim</span></NavLink>
                            <NavLink class="lm-side-link" href="vendor/slots"><Icon Name="clock" /><span>Átvételi időpontok</span></NavLink>
                            <NavLink class="lm-side-link" href="products" Match="NavLinkMatch.All"><Icon Name="store" /><span>A piac kínálata</span></NavLink>
                            <NavLink class="lm-side-link" href="markets"><Icon Name="pin" /><span>Piacok és standok</span></NavLink>
                        </div>
                        break;

                    case "Admin":
                        <div class="lm-side-group" role="group" aria-labelledby="ng-market">
                            <div class="lm-side-group-title" id="ng-market">Piac</div>
                            <NavLink class="lm-side-link" href="admin/producers"><Icon Name="users" /><span>Árusok</span></NavLink>
                            <NavLink class="lm-side-link" href="admin/markets"><Icon Name="pin" /><span>Piacok</span></NavLink>
                            <NavLink class="lm-side-link" href="admin/categories"><Icon Name="tag" /><span>Kategóriák</span></NavLink>
                            <NavLink class="lm-side-link" href="products" Match="NavLinkMatch.All"><Icon Name="store" /><span>Termékek</span></NavLink>
                        </div>
                        <div class="lm-side-group" role="group" aria-labelledby="ng-oversight">
                            <div class="lm-side-group-title" id="ng-oversight">Felügyelet</div>
                            <NavLink class="lm-side-link" href="admin/disputes"><Icon Name="scale" /><span>Viták</span></NavLink>
                            <NavLink class="lm-side-link" href="admin/reports"><Icon Name="chart" /><span>Riportok</span></NavLink>
                            <NavLink class="lm-side-link" href="admin/users"><Icon Name="user" /><span>Felhasználók</span></NavLink>
                            <NavLink class="lm-side-link" href="admin/audit"><Icon Name="history" /><span>Napló</span></NavLink>
                        </div>
                        break;
                }
            </nav>

            <div class="lm-sidebar-foot">
                <UserMenu />
            </div>
        </aside>
    </Authorized>

    <NotAuthorized>
        <header class="lm-topbar">
            <div class="lm-container">
                <a class="lm-brand" href="" aria-label="LocalMarket kezdőlap">
                    <span class="lm-brand-mark"><Icon Name="leaf" /></span>
                    <span class="lm-brand-text">LocalMarket</span>
                </a>
                <nav class="lm-topbar-nav" aria-label="Főmenü">
                    <NavLink class="lm-toplink" href="products" aria-label="Termékek"><Icon Name="bag" /><span>Termékek</span></NavLink>
                    <NavLink class="lm-toplink" href="markets" aria-label="Piacok"><Icon Name="pin" /><span>Piacok</span></NavLink>
                </nav>
                <div class="lm-topbar-actions">
                    <ThemeToggle />
                    <NavLink class="lm-toplink lm-toplink-login" href="login" aria-label="Bejelentkezés"><Icon Name="login" /><span>Bejelentkezés</span></NavLink>
                    <a class="btn btn-primary" href="register">Regisztráció</a>
                </div>
            </div>
        </header>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _open;

    private string CartLabel => Cart.ItemCount > 0 ? $"Kosár, {Cart.ItemCount} tétel" : "Kosár";

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthChanged;
        Cart.Changed += OnCartChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshCartCountAsync();
    }

    private void OnAuthChanged(Task<AuthenticationState> state) => _ = InvokeAsync(async () =>
    {
        await RefreshCartCountAsync();
        StateHasChanged();
    });

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    // navigáció után a mobil fiók magától bezárul
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    });

    private async Task OpenAsync()
    {
        _open = true;
        StateHasChanged();
        await Task.Yield();
        await FocusAsync("#lm-sidebar-close");
    }

    private async Task CloseAsync()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
        await FocusAsync("#lm-menu-button");
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private async Task FocusAsync(string selector)
    {
        try { await JS.InvokeVoidAsync("lmFocus", selector); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    // a navbar-számláló a kosár tényleges (szerver oldali) tartalmából jön, nem kliensoldali számolásból
    private async Task RefreshCartCountAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        if (Auth.Role == "Customer") await Cart.GetAsync();
        else Cart.Reset();
    }

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthChanged;
        Cart.Changed -= OnCartChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
