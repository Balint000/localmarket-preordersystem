@inject AuthStateService Auth
@inject NavigationManager Navigation
@inject CartService Cart

@* Az oldalsáv alja: ki van bejelentkezve, és a fiókkal kapcsolatos műveletek egy helyen, legördülő menü nélkül. *@
<div class="lm-user-card">
    <span class="lm-avatar" aria-hidden="true">@Initial</span>
    <span class="lm-user-text">
        <span class="lm-user-email" title="@Auth.Email">@Auth.Email</span>
        <span class="lm-user-role">@Labels.Role(Auth.Role ?? "")</span>
    </span>
</div>
<div class="lm-user-actions">
    <NavLink class="lm-side-link flex-grow-1" href="profile"><Icon Name="user" /><span>Profilom</span></NavLink>
    <ThemeToggle />
    <button type="button" class="lm-icon-btn" aria-label="Kijelentkezés" title="Kijelentkezés" @onclick="SignOutAsync">
        <Icon Name="logout" />
    </button>
</div>

@code {
    private string Initial => string.IsNullOrEmpty(Auth.Email) ? "?" : Auth.Email[..1].ToUpperInvariant();

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Cart.Reset();
        Navigation.NavigateTo("login");
    }
}
