@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService Auth
@inject ToastService Toasts
@inject NavigationManager Navigation

<a class="lm-skip-link" href="#main-content">Ugrás a tartalomra</a>

<div class="lm-shell">
    <NavMenu />

    <div class="lm-shell-main">
        <main id="main-content" class="lm-main" tabindex="-1">
            <div class="lm-container">
                @Body
            </div>
        </main>

        <footer class="lm-footer">
            <div class="lm-container">
                <span>LocalMarket – előrendelés a helyi termelői piacra</span>
                <span>Átvétel a piacon, a választott időpontban</span>
            </div>
        </footer>
    </div>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet role="alert">
    Váratlan hiba történt.
    <a href="." class="reload">Oldal újratöltése</a>
    <button type="button" class="dismiss btn-close" aria-label="Bezárás"></button>
</div>

@code {
    protected override void OnInitialized() => Auth.SessionExpired += OnSessionExpired;

    // lejárt vagy érvénytelen token: értesítés és vissza a bejelentkezéshez
    private void OnSessionExpired() => _ = InvokeAsync(() =>
    {
        Toasts.Error("A munkamenet lejárt, jelentkezz be újra.");
        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"login?returnUrl={returnUrl}");
    });

    public void Dispose() => Auth.SessionExpired -= OnSessionExpired;
}
