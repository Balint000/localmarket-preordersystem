@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService Auth
@inject ToastService Toasts
@inject NavigationManager Navigation

<a class="lm-skip-link" href="#main-content">Ugrás a tartalomra</a>
<NavMenu />

<main id="main-content" class="lm-main">
    <div class="container lm-container">
        @Body
    </div>
</main>

<footer class="lm-footer">
    <div class="container">LocalMarket – helyi termelői piac előrendelés</div>
</footer>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    Váratlan hiba történt.
    <a href="." class="reload">Újratöltés</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Auth.SessionExpired += OnSessionExpired;

    // lejárt vagy érvénytelen token: értesítés és vissza a bejelentkezéshez
    private void OnSessionExpired() => _ = InvokeAsync(() =>
    {
        Toasts.Error("A munkamenet lejárt, jelentkezz be újra.");
        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"login?returnUrl={returnUrl}");
    });

    public void Dispose() => Auth.SessionExpired -= OnSessionExpired;
}
