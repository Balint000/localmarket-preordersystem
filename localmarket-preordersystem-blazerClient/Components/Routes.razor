<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <Authorizing>
                <LoadingIndicator Text="Betöltés…" />
            </Authorizing>
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <PageContainer Title="Nincs jogosultságod">
                        <EmptyState Title="Ehhez az oldalhoz nincs hozzáférésed" IconName="lock"
                                    Text="Ezt az oldalt más szerepkörű fiók használhatja. Ha szerinted ez hiba, jelentkezz be a megfelelő fiókkal.">
                            <a class="btn btn-primary" href="dashboard">Vissza az áttekintéshez</a>
                        </EmptyState>
                    </PageContainer>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1"/>
    </Found>
</Router>
