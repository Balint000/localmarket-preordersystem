<a class="lm-order-row" href="@Href">
    <div>
        <div class="lm-order-title">
            <span>@(ShowCustomer ? (Order.CustomerName ?? $"Vásárló #{Order.CustomerId}") : (Order.ProducerName ?? $"Termelő #{Order.ProducerId}"))</span>
            <span class="lm-order-id">#@Order.Id</span>
        </div>
        <div class="lm-order-meta">
            <span><Icon Name="calendar" />Átvétel: @Labels.DateShort(Order.PickupDate) @Labels.Time(Order.PickupStart)–@Labels.Time(Order.PickupEnd)</span>
            <span><Icon Name="package" />@Order.Items.Count tétel</span>
        </div>
    </div>
    <div class="lm-order-side">
        <StatusBadge Status="@Order.Status" />
        <span class="lm-order-total">@Labels.Money(Order.TotalAmount)</span>
    </div>
    <Icon Name="chevron-right" CssClass="lm-order-chevron" />
</a>

@code {
    [Parameter, EditorRequired] public OrderInfo Order { get; set; } = default!;
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public bool ShowCustomer { get; set; }
}
