<dl class="lm-facts">
    <dt>Állapot</dt><dd><StatusBadge Status="@Order.Status" /></dd>
    <dt>Átvétel</dt>
    <dd>
        <strong>@Labels.DateLong(Order.PickupDate)</strong>
        <div class="small text-muted">@Labels.Time(Order.PickupStart)–@Labels.Time(Order.PickupEnd)</div>
    </dd>
    @if (ShowCustomer)
    {
        <dt>Vásárló</dt><dd>@(Order.CustomerName ?? $"#{Order.CustomerId}")</dd>
    }
    else
    {
        <dt>Termelő</dt><dd>@(Order.ProducerName ?? $"#{Order.ProducerId}")</dd>
    }
    @if (Order.Payment is { } p)
    {
        <dt>Fizetés</dt><dd>@Labels.Payment(p.Method)<div class="small text-muted">@Labels.Money(p.Amount), @Labels.PaymentStatus(p.Status)</div></dd>
    }
    <dt>Leadva</dt><dd>@Labels.DateTimeText(Order.CreatedAt)</dd>
    <dt>Azonosító</dt><dd>#@Order.Id</dd>
</dl>
@if (!string.IsNullOrWhiteSpace(Order.RejectionReason))
{
    <div class="lm-callout bad mt-3 mb-0"><Icon Name="x-circle" /><div class="lm-callout-body"><strong>@(Order.Status == "Cancelled" ? "A lemondás oka" : "Az elutasítás oka")</strong>@Order.RejectionReason</div></div>
}
@if (!string.IsNullOrWhiteSpace(Order.DisputeNote))
{
    <div class="mt-3">
        <div class="small fw-bold">Vita</div>
        <blockquote class="lm-quote mb-0">@Order.DisputeNote</blockquote>
    </div>
}

@code {
    [Parameter, EditorRequired] public OrderInfo Order { get; set; } = default!;
    /// <summary>Eladói nézetben a vásárló, vásárlói nézetben a termelő adatai látszanak.</summary>
    [Parameter] public bool ShowCustomer { get; set; }
}
