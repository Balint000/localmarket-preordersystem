<div class="lm-lines">
    @foreach (var item in Order.Items)
    {
        var shortfall = item.FulfilledQuantity < item.Quantity;
        <div class="lm-line simple">
            <div>
                <div class="lm-line-name">@item.ProductName</div>
                <div class="lm-line-sub">
                    @Labels.Qty(item.Quantity) @Labels.Unit(item.Unit) × @Labels.Money(item.UnitPrice)
                    @if (shortfall)
                    {
                        <span class="lm-chip lm-chip-warn ms-1 mb-0">teljesítve: @Labels.Qty(item.FulfilledQuantity) @Labels.Unit(item.Unit)</span>
                    }
                </div>
            </div>
            <div class="lm-line-total">@Labels.Money(item.Total)</div>
        </div>
    }
</div>
<div class="lm-summary"><span>Végösszeg</span><span>@Labels.Money(Order.TotalAmount)</span></div>

@code {
    [Parameter, EditorRequired] public OrderInfo Order { get; set; } = default!;
}
