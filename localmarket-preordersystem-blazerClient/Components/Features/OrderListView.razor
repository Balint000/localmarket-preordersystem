@* Közös rendeléslista: állapot szerinti szűrés (a szerveren), dátum szerinti rendezés (a letöltött listán). *@
<div class="lm-filterbar">
    <div>
        <div class="lm-filter-label" id="status-filter-label">Állapot</div>
        <div class="lm-pills scroll" role="group" aria-labelledby="status-filter-label">
            <button type="button" class="lm-pill" aria-pressed="@(_status == "" ? "true" : "false")" @onclick='() => SetStatusAsync("")'>Összes</button>
            @foreach (var s in Labels.OrderStatuses)
            {
                var status = s;
                <button type="button" class="lm-pill" aria-pressed="@(_status == status ? "true" : "false")" @onclick="() => SetStatusAsync(status)">@Labels.OrderStatus(status)</button>
            }
        </div>
    </div>
    <div class="lm-filterbar-row">
        <label class="form-label mb-0" for="order-sort">Rendezés</label>
        <select id="order-sort" class="form-select" @bind="_newestFirst">
            <option value="true">Legújabb elöl</option>
            <option value="false">Legrégebbi elöl</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <LoadingIndicator Text="Rendelések betöltése…" />
}
else if (_problem is not null)
{
    <ErrorMessage Problem="_problem" OnRetry="LoadAsync" />
}
else if (_orders.Count == 0)
{
    <EmptyState Title="@(_status == "" ? "Még nincs rendelés" : $"Nincs {Labels.OrderStatus(_status).ToLowerInvariant()} állapotú rendelés")"
                Text="@(_status == "" ? EmptyText : "Válassz másik állapotot, vagy nézd meg az összes rendelést.")" IconName="receipt">
        @if (_status == "") { @EmptyContent }
        else { <button type="button" class="btn btn-outline-primary" @onclick='() => SetStatusAsync("")'>Összes rendelés</button> }
    </EmptyState>
}
else
{
    <p class="lm-results-meta" aria-live="polite">@_orders.Count rendelés</p>
    <div class="lm-order-list">
        @foreach (var order in (_newestFirst ? _orders.OrderByDescending(o => o.CreatedAt) : _orders.OrderBy(o => o.CreatedAt)))
        {
            <OrderListItem Order="order" Href="@($"{DetailsBase}/{order.Id}")" ShowCustomer="ShowCustomer" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Func<string?, Task<ApiResult<IReadOnlyList<OrderInfo>>>> Loader { get; set; } = default!;
    [Parameter, EditorRequired] public string DetailsBase { get; set; } = "";
    [Parameter] public bool ShowCustomer { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    private IReadOnlyList<OrderInfo> _orders = [];
    private ApiProblem? _problem;
    private bool _loading = true;
    private bool _newestFirst = true;
    private string _status = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetStatusAsync(string status)
    {
        if (_status == status) return;
        _status = status;
        await LoadAsync();
    }

    public async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        var result = await Loader(string.IsNullOrEmpty(_status) ? null : _status);
        if (result.IsSuccess) _orders = result.Value!; else _problem = result.Problem;
        _loading = false;
    }
}
