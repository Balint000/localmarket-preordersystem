<article class="lm-product">
    <div class="lm-product-img @_look.Css" aria-hidden="true">
        @_look.Emoji
        @if (Product.NextStock is { } st)
        {
            <span class="lm-product-flag @(st.AvailableQuantity > 0 ? "ok" : "out")">@(st.AvailableQuantity > 0 ? "Elérhető" : "Elfogyott")</span>
        }
        else
        {
            <span class="lm-product-flag none">Nincs kínálat</span>
        }
    </div>
    <div class="lm-product-body">
        <a class="lm-product-name" href="products/@Product.Id">@Product.Name</a>
        <div class="text-muted small">@(Product.ProducerName ?? "Termelő")</div>
        <div>
            @foreach (var c in Product.Categories)
            {
                <span class="lm-chip">@c.Name</span>
            }
        </div>
        @if (Product.NextStock is { } stock)
        {
            <div class="lm-price">@Labels.Money(stock.UnitPrice) <span class="text-muted fw-normal small">/ @Labels.Unit(stock.Unit)</span></div>
            <div class="small @(stock.AvailableQuantity > 0 ? "text-success" : "text-danger")">
                @(stock.AvailableQuantity > 0 ? $"Elérhető: {Labels.Qty(stock.AvailableQuantity)} {Labels.Unit(stock.Unit)}" : "Elfogyott erre a hétre")
            </div>
        }
        else
        {
            <div class="small text-muted">Még nincs meghirdetett kínálat.</div>
        }
        <div class="mt-auto pt-2">
            <a class="btn btn-outline-primary btn-sm" href="products/@Product.Id">Részletek</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ProductInfo Product { get; set; } = default!;

    private (string Emoji, string Css) _look => Labels.CategoryLook(Product.Categories.FirstOrDefault()?.Name);
}
