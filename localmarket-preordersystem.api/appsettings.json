{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": { "TimeZone": "Europe/Budapest" },
  "Orders": {
    "CustomerCancellationCutoffHours": 12,
    "ExpiryEnabled": true,
    "ExpiryCheckMinutes": 15
  },
  "RateLimit": {
    "GeneralPerMinute": 1200,
    "AuthPerMinute": 60
  }
}
